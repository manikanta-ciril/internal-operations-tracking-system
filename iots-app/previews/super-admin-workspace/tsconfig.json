{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "react": [
        "../../authentication-system/frontend/node_modules/@types/react"
      ],
      "react/jsx-runtime": [
        "../../authentication-system/frontend/node_modules/@types/react/jsx-runtime"
      ],
      "react-dom/client": [
        "../../authentication-system/frontend/node_modules/@types/react-dom/client"
      ]
    }
  },
  "include": ["*.ts", "*.tsx"]
}
