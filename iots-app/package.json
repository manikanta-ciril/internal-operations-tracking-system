{
  "name": "iots-application",
  "version": "1.0.0",
  "private": true,
  "description": "Entry point for IOTS subsystems and local development",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "setup": "node scripts/setup.cjs",
    "build": "npm run build --prefix authentication-system/frontend",
    "lint": "npm run lint --prefix authentication-system/frontend",
    "test:unit": "npm run test:unit --prefix authentication-system/backend && node authentication-system/frontend/src/shared/theme/useTheme.test.cjs",
    "test:auth": "npm run test:auth --prefix authentication-system/backend"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
