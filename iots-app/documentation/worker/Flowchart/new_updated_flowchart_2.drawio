h Proof-of-Work&lt;/b&gt;&lt;br/&gt;Upload final document, code link, or output&lt;br/&gt;Complete mandatory checklist items" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1F2EB;strokeColor=#1ABC9C;fontColor=#117864;fontSize=12;fontFamily=Verdana;arcSize=6;" vertex="1" parent="1"><mxGeometry x="710" y="450" width="400" height="65" as="geometry" /></mxCell><mxCell id="eex_4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;endArrow=blockThin;endSize=8;endFill=1;strokeColor=#4A5568;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="ex1_check" target="ex2_block_q" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="eex_5" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;endArrow=blockThin;endSize=8;endFill=1;strokeColor=#4A5568;strokeWidth=2;" edge="1" source="ex2_block_q" target="ex2_raise" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="eex_6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;endArrow=blockThin;endSize=8;endFill=1;strokeColor=#4A5568;strokeWidth=2;" edge="1" source="ex2_raise" target="ex2_resume" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="eex_7" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;endArrow=blockThin;endSize=8;endFill=1;strokeColor=#4A5568;strokeWidth=2;" edge="1" source="ex2_block_q" target="ex2_attach" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="eex_8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;endArrow=blockThin;endSize=8;endFill=1;strokeColor=#4A5568;strokeWidth=2;" edge="1" source="ex2_resume" target="ex2_attach" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ex_b3" value="3. SUBMISSION, QA &amp;amp; CLOCK-