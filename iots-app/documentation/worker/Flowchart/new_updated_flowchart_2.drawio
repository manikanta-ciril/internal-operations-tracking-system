ly attendance tally&lt;br/&gt;Calculate loss of pay / overtime" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1F2EB;strokeColor=#1ABC9C;fontColor=#117864;fontSize=12;fontFamily=Verdana;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1230" y="360" width="400" height="65" as="geometry" /></mxCell><mxCell id="adm3_done" value="&lt;b&gt;Office Facility Day Complete&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1F4E79;strokeColor=#0D233A;fontColor=#FFFFFF;fontSize=14;fontStyle=1;fontFamily=Verdana;arcSize=4;" vertex="1" parent="1"><mxGeometry x="1230" y="460" width="400" height="50" as="geometry" /></mxCell><mxCell id="eadm_8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;endArrow=blockThin;endSize=8;endFill=1;strokeColor=#4A5568;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="adm2_pass" target="adm3_shift" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="eadm_9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;endArrow=blockThin;endSize=8;endFill=1;strokeColor=#4A5568;strokeWidth=2;" edge="1" source="adm3_shift" target="adm3_stream" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="eadm_10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;endArrow=blockThin;endSize=8;endFill=1;strokeColor=#4A5568;strokeWidth=2;" edge="1" source="adm3_stream" target="adm3_sync_hr" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="eadm_11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;endArrow=blockThin;endSize=8;endFill=1;strokeColor=#4A5568;strokeWidth=2;" edge="1" source="adm3_sync_hr" target="adm3_done" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="adm_log_box" value="&lt;b&gt;OFFICE ADMIN AUDIT DATA (LOGGED TO MASTER DATA STORE)&lt;/b&gt;&lt;br/&gt;• Attendance regularizations &amp;amp; GPS override rationale&lt;br/&gt;• Approved leave slips &amp;amp; remaining balance updates&lt;br/&gt;• Hardware asset assignments, serial numbers &amp;amp; user signatures&lt;br/&gt;• Weekly shift roster matrices &amp;amp; workstation pass IDs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAEDED;strokeColor=#7F8C8D;fontColor=#17202A;fontSize=12;fontStyle=1;dashed=1;dashPattern=6 6;fontFamily=Verdana;" vertex="1" parent="1"><mxGeometry x="150" y="670" width="740" height="160" as="geometry" /></mxCell><mxCell id="adm_intel_box" value="&lt;b&gt;INTELLIGENCE PERSPECTIVE CONSUMED BY OFFICE ADMIN&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Punctuality Engine:&lt;/b&gt; Department tardiness &amp;amp; absenteeism metrics&lt;br/&gt;• &lt;b&gt;Workstation Capacity:&lt;/b&gt; Office desk occupancy rate &amp;amp; facility density&lt;br/&gt;• &lt;b&gt;Hardware Lifespan:&lt;/b&gt; Asset aging, maintenance schedule &amp;amp; warranty expiries&lt;br/&gt;• &lt;b&gt;Payroll Input:&lt;/b&gt; Net billable working days per employee for salary computation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4E6F1;strokeColor=#2980B9;fontColor=#1B4F72;fontSize=12;fontStyle=1;dashed=1;dashPattern=6 6;fontFamily=Verdana;" vertex="1" parent="1"><mxGeometry x="930" y="670" width="740" height="160" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="page_gm_ipsheeta" name="General Manager (Ipsheeta) - Commercial Strategy &amp; Sign-Offs"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="2200" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="gm_title" value="&lt;b&gt;GENERAL MANAGER (IPSHEETA) - COMMERCIAL GOVERNANCE &amp;amp; MULTI-DEPT OVERSIGHT&lt;/b&gt;&lt;br/&gt;&lt;i&gt;Enforcing CIRIL 30/70 Commercial Rule, Cross-Department SLA Reviews &amp;amp; Executive Approvals&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1F4E79;strokeColor=#0D233A;fontColor=#FFFFFF;fontSize=14;fontStyle=1;fontFamily=Verdana;arcSize=4;" vertex="1" parent="1"><mxGeometry x="100" y="30" width="1600" height="60" as="geometry" /></mxCell><mxCell id="gm_b1" value="1. EXECUTIVE MORNING BRIEFING &amp;amp; PIPELINE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#F5B041;fontColor=#7D6608;fontSize=14;fontStyle=1;dashed=1;dashPattern=8 8;pointerEvents=0;connectable=0;" vertex="1" parent="1"><mxGeometry x="150" y="120" width="480" height="520" as="geometry" /></mxCell><mxCell id="gm1_login" value="&lt;b&gt;GM Secure Login&lt;/b&gt;&lt;br/&gt;Access General Management Interface&lt;br/&gt;Review Enterprise Status Matrix" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCF3CF;strokeColor=#D68910;fontColor=#7D6608;fontSize=12;fontFamily=Verdana;arcSize=6;" vertex="1" parent="1"><mxGeometry x="190" y="170" width="400" height="60" as="geometry" /></mxCell><mxCell id="gm1_brief" value="&lt;b&gt;Inspect Daily Operational Brief&lt;/b&gt;&lt;br/&gt;Completed tasks from yesterday&lt;br/&gt;Pending approvals &amp;amp; blocker alerts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCF3CF;strokeColor=#D68910;fontColor=#7D6608;fontSize=12;fontFamily=Verdana;arcSize=6;" vertex="1" parent="1"><mxGeometry x="190" y="260" width="400" height="65" as="geometry" /></mxCell><mxCell id="gm1_pipe" value="&lt;b&gt;Commercial Pipeline Radar&lt;/b&gt;&lt;br/&gt;Inspect BDE Bhavani's qualified leads&lt;br/&gt;Verify high-value deal progress" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCF3CF;strokeColor=#D68910;fontColor=#7D6608;fontSize=12;fontFamily=Verdana;arcSize=6;" vertex="1" parent="1"><mxGeometry x="190" y="355" width="400" height="65" as="geometry" /></mxCell><mxCell id="gm1_budget" value="&lt;b&gt;Review Department Budgets&lt;/b&gt;&lt;br/&gt;Track expenditure vs monthly limits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FC