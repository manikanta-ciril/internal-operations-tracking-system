&lt;/b&gt;&lt;br/&gt;GPS Geofence Match (within 50m of office)&lt;br/&gt;Selfie Photo Stamp Confirmed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1F2EB;strokeColor=#1ABC9C;fontColor=#117864;fontSize=12;fontFamily=Verdana;arcSize=6;" vertex="1" parent="1"><mxGeometry x="190" y="170" width="400" height="60" as="geometry" /></mxCell><mxCell id="ex1_dash" value="&lt;b&gt;Open Executive Task Queue&lt;/b&gt;&lt;br/&gt;View tasks assigned by Lead Manager Manasa&lt;br/&gt;Prioritized by SLA deadline &amp;amp; urgency" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1F2EB;strokeColor=#1ABC9C;fontColor=#117864;fontSize=12;fontFamily=Verdana;arcSize=6;" vertex="1" parent="1"><mxGeometry x="190" y="260" width="400" height="65" as="geometry" /></mxCell><mxCell id="ex1_start" value="&lt;b&gt;Select Task &amp;amp; Click 'Start Task'&lt;/b&gt;&lt;br/&gt;Task status transitions to 'In Progress'&lt;br/&gt;Live stopwatch timer begins logging" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5F5E3;strokeColor=#27AE60;fontColor=#1E8449;fontSize=12;fontFamily=Verdana;arcSize=6;" vertex="1" parent="1"><mxGeometry x="190" y="355" width="400" height="65" as="geometry" /></mxCell><mxCell id="ex1_check" value="&lt;b&gt;Follow Checklist Items&lt;/b&gt;&lt;br/&gt;Execute step-by-step requirements" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1F2EB;strokeColor=#1ABC9C;fontColor=#117864;fontSize=12;fontFamily=Verdana;arcSize=6;" vertex="1" parent="1"><mxGeometry x="190" y="450" width="400" height="55" as="geometry" /></mxCell><mxCell id="eex_1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;endArrow=blockThin;endSize=8;endFill=1;strokeColor=#4A5568;strokeWidth=2;" edge="1" source="ex1_login" target="ex1_dash" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="eex_2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;endArrow=blockThin;endSize=8;endFill=1;strokeC