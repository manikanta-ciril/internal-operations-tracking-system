<?xml version='1.0' encoding='utf-8'?>
<mxfile host="Electron" pages="1"><diagram id="gemini-iots-architecture" name="CIRIL IOTS — Complete Operational Architecture"><mxGraphModel dx="3024" dy="1456" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="5200" pageHeight="7560" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="hdr_main" value="CIRIL • INTERNAL OPERATIONS TRACKING SYSTEM (IOTS) — ARCHITECTURAL BLUEPRINT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A365D;strokeColor=#1A365D;fontColor=#FFFFFF;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="1" vertex="1"><mxGeometry x="60" y="40" width="5080" height="65" as="geometry" /></mxCell><mxCell id="hdr_sub" value="Complete End-to-End Operational Architecture: Authentication &amp; Location Layer (Top) → Management &amp; Operational Workspaces (Middle) → Shared Records Database → Intelligence, Analytics &amp; Chairman Oversight (Bottom)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F7FAFC;strokeColor=#CBD5E0;fontColor=#2D3748;fontSize=13;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="60" y="115" width="5080" height="45" as="geometry" /></mxCell><mxCell id="sec_layer1" value="LAYER 1 • AUTHENTICATION, LOCATION AUDIT &amp; ROLE WORKSPACE ROUTING" style="swimlane;startSize=40;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#2B6CB0;fontColor=#FFFFFF;fontSize=14;fontStyle=1;swimlaneFillColor=#F0F4F8;swimlaneLine=0;strokeWidth=2;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="1" vertex="1"><mxGeometry x="60" y="180" width="5080" height="720" as="geometry" /></mxCell><mxCell id="l1_start" value="START • Corporate Login" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#1A365D;strokeColor=#1A365D;fontColor=#FFFFFF;fontSize=14;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;fontStyle=1;" parent="sec_layer1" vertex="1"><mxGeometry x="100" y="70" width="240" height="65" as="geometry" /></mxCell><mxCell id="l1_input" value="User Enters Credentials&lt;br&gt;&lt;b&gt;Corporate Email / ID + Password&lt;/b&gt;&lt;br&gt;&lt;i&gt;*Strictly No Public Registration&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EBF8FF;strokeColor=#3182CE;fontColor=#2B6CB0;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="sec_layer1" vertex="1"><mxGeometry x="380" y="70" width="300" height="65" as="geometry" /></mxCell><mxCell id="l1_val_cred" value="Credentials&lt;br&gt;Valid?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEFCBF;strokeColor=#D69E2E;fontColor=#744210;fontSize=12;fontStyle=1;spacing=6;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="sec_layer1" vertex="1"><mxGeometry x="720" y="57" width="160" height="90" as="geometry" /></mxCell><mxCell id="l1_err_cred" value="Authentication Failed&lt;br&gt;&lt;b&gt;Show Error &amp; Increment Counter&lt;/b&gt;&lt;br&gt;Lockout / Admin Password Reset" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#E53E3E;fontColor=#9B2C2C;fontSize=11;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="sec_layer1" vertex="1"><mxGeometry x="720" y="180" width="260" height="65" as="geometry" /></mxCell><mxCell id="l1_chk_active" value="Account&lt;br&gt;Active?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEFCBF;strokeColor=#D69E2E;fontColor=#744210;fontSize=12;fontStyle=1;spacing=6;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="sec_layer1" vertex="1"><mxGeometry x="930" y="57" width="160" height="90" as="geometry" /></mxCell><mxCell id="l1_err_deact" value="Account Suspended / Inactive&lt;br&gt;&lt;b&gt;Access Prohibited&lt;/b&gt;&lt;br&gt;Contact Super Admin Governance" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#E53E3E;fontColor=#9B2C2C;fontSize=11;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="sec_layer1" vertex="1"><mxGeometry x="930" y="180" width="260" height="65" as="geometry" /></mxCell><mxCell id="l1_req_loc" value="Validate Location Context&lt;br&gt;&lt;b&gt;Browser / Device Geolocation Call&lt;/b&gt;&lt;br&gt;Query BigDataCloud Geocoding API" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EBF8FF;strokeColor=#3182CE;fontColor=#2B6CB0;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="sec_layer1" vertex="1"><mxGeometry x="1140" y="70" width="300" height="65" as="geometry" /></mxCell><mxCell id="l1_eval_geo" value="Compare GPS Coordinates against&lt;br&gt;Approved Office Geofence Radius" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EBF8FF;strokeColor=#3182CE;fontColor=#2B6CB0;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="sec_layer1" vertex="1"><mxGeometry x="1480" y="70" width="300" height="65" as="geometry" /></mxCell><mxCell id="l1_dec_geo" value="Location&lt;br&gt;Recognized?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEFCBF;strokeColor=#D69E2E;fontColor=#744210;fontSize=12;fontStyle=1;spacing=6;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="sec_layer1" vertex="1"><mxGeometry x="1820" y="57" width="160" height="90" as="geometry" /></mxCell><mxCell id="l1_geo_on" value="Inside Approved Perimeter&lt;br&gt;&lt;b&gt;Session Tag: ON-SITE&lt;/b&gt;&lt;br&gt;Standard Office Context" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0FFF4;strokeColor=#38A169;fontColor=#22543D;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;fontStyle=1;" parent="sec_layer1" vertex="1"><mxGeometry x="2040" y="50" width="260" height="60" as="geometry" /></mxCell><mxCell id="l1_geo_off" value="Outside Approved Perimeter&lt;br&gt;&lt;b&gt;Session Tag: REMOTE / OFF-SITE&lt;/b&gt;&lt;br&gt;Prompt Reason for Attendance Audit" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFAF0;strokeColor=#DD6B20;fontColor=#7B341E;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;fontStyle=1;" parent="sec_layer1" vertex="1"><mxGeometry x="2040" y="125" width="260" height="60" as="geometry" /></mxCell><mxCell id="l1_geo_unk" value="Location Denied / Inaccurate&lt;br&gt;&lt;b&gt;Session Tag: UNKNOWN LOCATION&lt;/b&gt;&lt;br&gt;Flagged for Admin Location Audit" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#E53E3E;fontColor=#9B2C2C;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;fontStyle=1;" parent="sec_layer1" vertex="1"><mxGeometry x="2040" y="200" width="260" height="60" as="geometry" /></mxCell><mxCell id="l1_audit_log" value="Session Audit &amp; Context Capture&lt;br&gt;&lt;b&gt;Immutable Audit Record Written:&lt;/b&gt;&lt;br&gt;User ID • Timestamp • GPS • IP • Session Tag" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EBF8FF;strokeColor=#2B6CB0;fontColor=#1A365D;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;fontStyle=1;" parent="sec_layer1" vertex="1"><mxGeometry x="2360" y="70" width="340" height="65" as="geometry" /></mxCell><mxCell id="l1_eval_roles" value="RBAC Engine: Evaluate Authorized Roles&lt;br&gt;&lt;b&gt;1 Identity → Multiple Authorized Roles&lt;/b&gt;&lt;br&gt;Detect Primary Workspace &amp; Role Scope" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#805AD5;fontColor=#44337A;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;fontStyle=1;" parent="sec_layer1" vertex="1"><mxGeometry x="2740" y="70" width="340" height="65" as="geometry" /></mxCell><mxCell id="l1_role_dec" value="Multiple&lt;br&gt;Roles?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEFCBF;strokeColor=#D69E2E;fontColor=#744210;fontSize=12;fontStyle=1;spacing=6;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="sec_layer1" vertex="1"><mxGeometry x="3120" y="57" width="160" height="90" as="geometry" /></mxCell><mxCell id="l1_primary_land" value="Default Landing:&lt;br&gt;&lt;b&gt;Primary Role Workspace Dashboard&lt;/b&gt;&lt;br&gt;Enforce Authorized Permission Boundaries" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EBF8FF;strokeColor=#3182CE;fontColor=#2B6CB0;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="sec_layer1" vertex="1"><mxGeometry x="3340" y="50" width="300" height="65" as="geometry" /></mxCell><mxCell id="l1_ctx_switcher" value="Instant Context Switcher Enabled:&lt;br&gt;&lt;b&gt;Global Navigation 1-Click Role Switch&lt;/b&gt;&lt;br&gt;Switch Workspaces without Re-authenticating" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#805AD5;fontColor=#44337A;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;fontStyle=1;" parent="sec_layer1" vertex="1"><mxGeometry x="3340" y="130" width="320" height="65" as="geometry" /></mxCell><mxCell id="l1_audit_segreg" value="Session &amp; Audit Segregation:&lt;br&gt;&lt;b&gt;Every Operational Action is Tagged With:&lt;/b&gt;&lt;br&gt;[Employee Identity] + [Active Role Context]" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#805AD5;fontColor=#44337A;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;fontStyle=1;" parent="sec_layer1" vertex="1"><mxGeometry x="3700" y="70" width="340" height="65" as="geometry" /></mxCell><mxCell id="l1_dispatch" value="WORKSPACE DISPATCH ROUTER:&lt;br&gt;&lt;b&gt;Route User to Active Operational Lane&lt;/b&gt;&lt;br&gt;Admin Lane • Management Lane • Execution Lane" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#1A365D;strokeColor=#1A365D;fontColor=#FFFFFF;fontSize=13;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;fontStyle=1;" parent="sec_layer1" vertex="1"><mxGeometry x="4080" y="70" width="360" height="65" as="geometry" /></mxCell><mxCell id="edge_1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="l1_start" target="l1_input"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="l1_input" target="l1_val_cred"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_3" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="l1_val_cred" target="l1_err_cred"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_4" value="Retry" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" parent="1" edge="1" source="l1_err_cred" target="l1_input"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_5" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="l1_val_cred" target="l1_chk_active"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_6" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="l1_chk_active" target="l1_err_deact"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_7" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="l1_chk_active" target="l1_req_loc"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="l1_req_loc" target="l1_eval_geo"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="l1_eval_geo" target="l1_dec_geo"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_10" value="Inside" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="l1_dec_geo" target="l1_geo_on"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_11" value="Outside" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="l1_dec_geo" target="l1_geo_off"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_12" value="Denied" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="l1_dec_geo" target="l1_geo_unk"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="l1_geo_on" target="l1_audit_log"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="l1_geo_off" target="l1_audit_log"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="l1_geo_unk" target="l1_audit_log"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="l1_audit_log" target="l1_eval_roles"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="l1_eval_roles" target="l1_role_dec"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_18" value="Single" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="l1_role_dec" target="l1_primary_land"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_19" value="Multi-Role" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="l1_role_dec" target="l1_ctx_switcher"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="l1_primary_land" target="l1_audit_segreg"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_21" value="Role Switch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="l1_ctx_switcher" target="l1_audit_segreg"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="l1_audit_segreg" target="l1_dispatch"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l1_note" value="MULTI-ROLE ARCHITECTURAL PRINCIPLE: Unified authentication guarantees single employee identity without separate accounts. Dual-role profiles (e.g. Harshitha acting as Creatives Associate + Executive) operate seamlessly via context switching, preserving individual accountability and audit integrity across all organizational activities." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EDF2F7;strokeColor=#CBD5E0;fontColor=#4A5568;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="sec_layer1" vertex="1"><mxGeometry x="100" y="630" width="4880" height="45" as="geometry" /></mxCell><mxCell id="sec_layer2" value="LAYER 2 • MANAGEMENT, OPERATIONS &amp; WORK DELIVERY LAYER" style="swimlane;startSize=45;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2D3748;fontColor=#FFFFFF;fontSize=14;fontStyle=1;swimlaneFillColor=#FFFFFF;swimlaneLine=0;strokeWidth=2;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="1" vertex="1"><mxGeometry x="60" y="930" width="5080" height="4000" as="geometry" /></mxCell><mxCell id="lane_admin" value="ADMINISTRATIVE GOVERNANCE WORKSPACE (Admin • Super Admin • IT System Analyst)" style="swimlane;startSize=40;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EBF8FF;strokeColor=#2B6CB0;fontColor=#FFFFFF;fontSize=14;fontStyle=1;swimlaneFillColor=#EBF8FF;swimlaneLine=0;strokeWidth=2;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="sec_layer2" vertex="1"><mxGeometry x="80" y="70" width="1600" height="1800" as="geometry" /></mxCell><mxCell id="adm_1" value="1. User Provisioning &amp; Account Management (Admin)&lt;br&gt;• Manual creation: Emp ID, Designation, Dept, Office, Role, Manager&lt;br&gt;• Strictly no public registration; accounts activated upon review&lt;br&gt;• Super Admin holds sole authority to deactivate high-level accounts" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3182CE;fontColor=#1A365D;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="lane_admin" vertex="1"><mxGeometry x="40" y="60" width="1520" height="80" as="geometry" /></mxCell><mxCell id="adm_2" value="2. Geofence Perimeter &amp; Location Control (Admin)&lt;br&gt;• Configure approved office GPS coordinates and allowable radius boundaries&lt;br&gt;• Define working hours, grace periods, and shift attendance rules&lt;br&gt;• Location audit review: investigate off-site/unknown location logs" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3182CE;fontColor=#1A365D;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="lane_admin" vertex="1"><mxGeometry x="40" y="160" width="1520" height="80" as="geometry" /></mxCell><mxCell id="adm_3" value="3. Global Task Oversight &amp; Archival (Admin)&lt;br&gt;• Global monitoring of active organizational queues; identify abandoned tasks&lt;br&gt;• Change assignment, update instructions, or stop assignments where authorized&lt;br&gt;• Business approvals strictly require explicit management permission" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3182CE;fontColor=#1A365D;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="lane_admin" vertex="1"><mxGeometry x="40" y="260" width="1520" height="80" as="geometry" /></mxCell><mxCell id="adm_4" value="4. Master Organization &amp; RBAC Configurations (Super Admin)&lt;br&gt;• Master org hierarchy, department definitions, designation taxonomies&lt;br&gt;• Configures Role-Based Access Control (RBAC) permission matrices&lt;br&gt;• Manages data export covenants, compliance frameworks, and retention policies" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3182CE;fontColor=#1A365D;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="lane_admin" vertex="1"><mxGeometry x="40" y="360" width="1520" height="80" as="geometry" /></mxCell><mxCell id="adm_5" value="5. Application &amp; Infrastructure Health (IT System Analyst)&lt;br&gt;• Equal platform privileges to Super Admin; tailored for technical monitoring&lt;br&gt;• Real-time server uptime, database response latency, and frontend health&lt;br&gt;• Track BigDataCloud geocoding API, mail server rate-limits, storage quotas" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3182CE;fontColor=#1A365D;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="lane_admin" vertex="1"><mxGeometry x="40" y="460" width="1520" height="80" as="geometry" /></mxCell><mxCell id="adm_6" value="6. Security Auditing &amp; Technical Incident Response (IT System Analyst)&lt;br&gt;• Analyze anomalous login attempts, sudden location jumps, session timeouts&lt;br&gt;• Log and resolve platform bugs, database deadlocks, webhook delivery failures&lt;br&gt;• Deployment tracking: system version updates, environment vars, schema migrations" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3182CE;fontColor=#1A365D;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="lane_admin" vertex="1"><mxGeometry x="40" y="560" width="1520" height="80" as="geometry" /></mxCell><mxCell id="adm_7" value="7. Security &amp; Immutable Audit Viewer (Super Admin / IT Analyst)&lt;br&gt;• Inspect full, immutable activity logs: filter by date, user, role, action&lt;br&gt;• Review login history, modification diffs, and network/location events&lt;br&gt;• Export authorized security and audit compliance reports" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3182CE;fontColor=#1A365D;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="lane_admin" vertex="1"><mxGeometry x="40" y="660" width="1520" height="80" as="geometry" /></mxCell><mxCell id="adm_8" value="8. Enterprise Communications &amp; Announcements (Admin)&lt;br&gt;• Draft official company notices; select target audience (team/dept/all)&lt;br&gt;• Set display schedule and broadcast duration; publish to employee portals&lt;br&gt;• Archive notice history, expiry events, and recipient acknowledgment status" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3182CE;fontColor=#1A365D;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="lane_admin" vertex="1"><mxGeometry x="40" y="760" width="1520" height="80" as="geometry" /></mxCell><mxCell id="adm_auth_note" value="GOVERNANCE BOUNDARY: IT Analyst &amp; Super Admin possess equal platform technical authority. However, IT Analysts cannot approve business decisions (e.g. employee annual leave, commercial fee splits, or budget allocations)." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EBF8FF;strokeColor=#3182CE;fontColor=#2B6CB0;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;fontStyle=1;" parent="lane_admin" vertex="1"><mxGeometry x="40" y="860" width="1520" height="55" as="geometry" /></mxCell><mxCell id="lane_mgr" value="OPERATIONAL MANAGEMENT WORKSPACE (General Manager • Senior Manager • Lead Manager)" style="swimlane;startSize=40;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFAF0;strokeColor=#DD6B20;fontColor=#FFFFFF;fontSize=14;fontStyle=1;swimlaneFillColor=#FFFAF0;swimlaneLine=0;strokeWidth=2;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="sec_layer2" vertex="1"><mxGeometry x="1740" y="70" width="1600" height="1800" as="geometry" /></mxCell><mxCell id="mgr_1" value="1. Overall Operations &amp; Board Coordination (General Manager)&lt;br&gt;• Oversee day-to-day branch execution; ensure smooth operational continuity&lt;br&gt;• Coordinate with Board of Directors for meetings, agendas, minutes &amp; follow-ups&lt;br&gt;• Accounts &amp; finance: track invoices, vendor payments, and operational expenses" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DD6B20;fontColor=#7B341E;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="lane_mgr" vertex="1"><mxGeometry x="40" y="60" width="1520" height="80" as="geometry" /></mxCell><mxCell id="mgr_2" value="2. Compliance, Legal &amp; Conferences (General Manager)&lt;br&gt;• Statutory compliance filings and coordination with Auditor&lt;br&gt;• Legal: membership agreements, contracts, NDAs, and documentation&lt;br&gt;• Organize Annual &amp; Zonal Conferences: hotels, vendors, members, speakers" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DD6B20;fontColor=#7B341E;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="lane_mgr" vertex="1"><mxGeometry x="40" y="160" width="1520" height="80" as="geometry" /></mxCell><mxCell id="mgr_3" value="3. Prospective Member Presentations (General Manager)&lt;br&gt;• Conduct virtual discussions with prospective commercial brokerages&lt;br&gt;• Present CIRIL's value proposition and expand member office network&lt;br&gt;• Support BDE outreach conversions with executive leadership engagement" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DD6B20;fontColor=#7B341E;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="lane_mgr" vertex="1"><mxGeometry x="40" y="260" width="1520" height="80" as="geometry" /></mxCell><mxCell id="mgr_4" value="4. Cross-Team Workload Balancing &amp; SLA Risk (Senior Manager)&lt;br&gt;• Monitor workload distribution across operations, BD, and creative associates&lt;br&gt;• Identify tasks at risk of missing client or member deadlines; balance capacity&lt;br&gt;• Evaluate high-impact escalations; analyze comparative productivity trends" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DD6B20;fontColor=#7B341E;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="lane_mgr" vertex="1"><mxGeometry x="40" y="360" width="1520" height="80" as="geometry" /></mxCell><mxCell id="mgr_5" value="5. Member Office Deals &amp; Royalty Coordination (Lead Manager - Manasa)&lt;br&gt;• Coordinate with member offices regarding concluded commercial deals&lt;br&gt;• Follow up rigorously on CIRIL's 7.5% royalty payment obligations&lt;br&gt;• Member office agreements and annual membership fee collection tracking" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DD6B20;fontColor=#7B341E;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="lane_mgr" vertex="1"><mxGeometry x="40" y="460" width="1520" height="80" as="geometry" /></mxCell><mxCell id="mgr_6" value="6. Vertical Calls &amp; Lead Exchange Coordination (Lead Manager - Manasa)&lt;br&gt;• Manage zone-wise vertical calls: Retail, Logistics &amp; Warehousing, Land, Hotel&lt;br&gt;• Direct client call handling across commercial verticals&lt;br&gt;• Prepare quarterly lead exchange details and business statistics across member offices" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DD6B20;fontColor=#7B341E;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="lane_mgr" vertex="1"><mxGeometry x="40" y="560" width="1520" height="80" as="geometry" /></mxCell><mxCell id="mgr_7" value="7. Portals, Website &amp; Collaterals Coordination (Lead Manager - Manasa)&lt;br&gt;• Upload listings to Office Space portal; distribute incoming inquiries to members&lt;br&gt;• Coordinate website updates and changes with vendor Bitra&lt;br&gt;• Printing &amp; stationery coordination for market research reports &amp; conference collateral" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DD6B20;fontColor=#7B341E;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="lane_mgr" vertex="1"><mxGeometry x="40" y="660" width="1520" height="80" as="geometry" /></mxCell><mxCell id="mgr_8" value="8. Task Planning, Delegation &amp; Review (Lead / Senior Manager)&lt;br&gt;• Define task deliverables, priority, due date, and acceptance criteria&lt;br&gt;• Check employee capacity and assign; monitor progress through delivery&lt;br&gt;• Review submitted work: Approve &amp; Close OR Changes Requested revision cycle" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DD6B20;fontColor=#7B341E;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="lane_mgr" vertex="1"><mxGeometry x="40" y="760" width="1520" height="80" as="geometry" /></mxCell><mxCell id="mgr_scope_note" value="MANAGEMENT ROLE DELINEATION: General Manager provides overall operational governance and Board/Finance alignment; Senior Manager drives cross-team capacity and risk mitigation; Lead Manager (Manasa) drives day-to-day vertical operations, deal royalty follow-up, and vendor coordination." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFAF0;strokeColor=#DD6B20;fontColor=#7B341E;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;fontStyle=1;" parent="lane_mgr" vertex="1"><mxGeometry x="40" y="860" width="1520" height="55" as="geometry" /></mxCell><mxCell id="lane_exec" value="EXECUTION &amp; WORK DELIVERABLES WORKSPACE (Executive • BDE • Creatives Associate)" style="swimlane;startSize=40;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F0FFF4;strokeColor=#276749;fontColor=#FFFFFF;fontSize=14;fontStyle=1;swimlaneFillColor=#F0FFF4;swimlaneLine=0;strokeWidth=2;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="sec_layer2" vertex="1"><mxGeometry x="3400" y="70" width="1600" height="1800" as="geometry" /></mxCell><mxCell id="exe_1" value="1. Focused Task Execution (Executive)&lt;br&gt;• Personal task queue: clear deliverables, due dates, and priority rank&lt;br&gt;• Start/continue work with zero distractions; update progress percentage&lt;br&gt;• Record activity notes, log effort time, and attach versioned deliverables" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#38A169;fontColor=#1C4532;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="lane_exec" vertex="1"><mxGeometry x="40" y="60" width="1520" height="80" as="geometry" /></mxCell><mxCell id="exe_2" value="2. Issue &amp; Blocker Reporting (Executive)&lt;br&gt;• Encounter operational impediment → raise linked Blocker Ticket&lt;br&gt;• Assign severity (Low / Medium / High / Critical) and impact description&lt;br&gt;• Work paused until manager intervention; resume work upon resolution" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#38A169;fontColor=#1C4532;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="lane_exec" vertex="1"><mxGeometry x="40" y="160" width="1520" height="80" as="geometry" /></mxCell><mxCell id="exe_3" value="3. Submission &amp; Revision Cycles (Executive)&lt;br&gt;• Submit deliverables for manager review (Status: Waiting for Review)&lt;br&gt;• Incorporate manager feedback if changes requested; preserve version history&lt;br&gt;• Resubmit corrected deliverables until final approval and closure" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#38A169;fontColor=#1C4532;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="lane_exec" vertex="1"><mxGeometry x="40" y="260" width="1520" height="80" as="geometry" /></mxCell><mxCell id="exe_4" value="4. Broker Prospect Research (Business Development Executive - Bhavani)&lt;br&gt;• Research and compile verified commercial broker contacts from RERA portals&lt;br&gt;• Commercial directories and Google prospect sourcing across target territories&lt;br&gt;• Maintain verified prospect database with contact details and brokerage scale" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#38A169;fontColor=#1C4532;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="lane_exec" vertex="1"><mxGeometry x="40" y="360" width="1520" height="80" as="geometry" /></mxCell><mxCell id="exe_5" value="5. Outreach Campaigns &amp; Pipeline Management (BDE - Bhavani)&lt;br&gt;• Daily cold calls and structured email outreach to prospective member brokerages&lt;br&gt;• Professional WhatsApp campaigns introducing CIRIL's pan-India network&lt;br&gt;• Operate Upturnly lead generation portal and 99acres commercial portal" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#38A169;fontColor=#1C4532;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="lane_exec" vertex="1"><mxGeometry x="40" y="460" width="1520" height="80" as="geometry" /></mxCell><mxCell id="exe_6" value="6. Meeting Scheduling &amp; Follow-Up Rigor (BDE - Bhavani)&lt;br&gt;• Maintain rigorous follow-up queue; log call outcomes and next contact date&lt;br&gt;• Schedule virtual pitch meetings for General Manager with qualified prospects&lt;br&gt;• Track pipeline progression from Initial Contact → Interested → Pitch → Closed" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#38A169;fontColor=#1C4532;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="lane_exec" vertex="1"><mxGeometry x="40" y="560" width="1520" height="80" as="geometry" /></mxCell><mxCell id="exe_7" value="7. End-to-End Social Media Management (Creatives Associate - Harshitha)&lt;br&gt;• Brand campaign management across LinkedIn, Instagram, YouTube, and corporate channels&lt;br&gt;• Content production pipeline: Brief → Drafting → Review → Changes → Approved → Published&lt;br&gt;• Track engagement analytics and campaign performance metrics" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#38A169;fontColor=#1C4532;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="lane_exec" vertex="1"><mxGeometry x="40" y="660" width="1520" height="80" as="geometry" /></mxCell><mxCell id="exe_8" value="8. Graphic Design &amp; Collateral Production (Creatives Associate - Harshitha)&lt;br&gt;• Transform raw concepts &amp; data into polished, institutional-grade visual assets&lt;br&gt;• Strict versioning control on iterative drafts (v1.0, v1.1, v2.0)&lt;br&gt;• Design conference collaterals, ID badges, banners, and keynote presentation decks" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#38A169;fontColor=#1C4532;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="lane_exec" vertex="1"><mxGeometry x="40" y="760" width="1520" height="80" as="geometry" /></mxCell><mxCell id="exe_9" value="9. Market Reports &amp; Vertical Calls Support (Creatives Associate - Harshitha)&lt;br&gt;• Proofread &amp; format quarterly market research publications for brand alignment&lt;br&gt;• Support Lead Manager on Office Vertical calls and zone-wise client updates&lt;br&gt;• Multi-role profile: acts as Social Media Manager + Executive seamlessly" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#38A169;fontColor=#1C4532;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="lane_exec" vertex="1"><mxGeometry x="40" y="860" width="1520" height="80" as="geometry" /></mxCell><mxCell id="exe_multi_note" value="MULTI-ROLE EXECUTION REALITY: Harshitha executes dual responsibilities—Brand/Social Media Manager and Office Vertical Executive. She utilizes the Global Nav Context Switcher to switch active workspace contexts under one corporate account without permission overlap." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0FFF4;strokeColor=#38A169;fontColor=#1C4532;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;fontStyle=1;" parent="lane_exec" vertex="1"><mxGeometry x="40" y="960" width="1520" height="55" as="geometry" /></mxCell><mxCell id="edge_23" value="Admin Context" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;exitX=0.2;exitY=1;entryX=0.5;entryY=0;" parent="1" edge="1" source="l1_dispatch" target="lane_admin"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_24" value="Manager Context" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" edge="1" source="l1_dispatch" target="lane_mgr"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_25" value="Execution Context" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;exitX=0.8;exitY=1;entryX=0.5;entryY=0;" parent="1" edge="1" source="l1_dispatch" target="lane_exec"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1_box" value="PIPELINE A • SHARED WORK LIFECYCLE: PLAN → ASSIGN → DELIVER → REVIEW → CLOSE" style="swimlane;startSize=35;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F7FAFC;strokeColor=#4A5568;fontColor=#1A202C;fontSize=14;fontStyle=1;swimlaneFillColor=#F7FAFC;swimlaneLine=0;strokeWidth=2;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="sec_layer2" vertex="1"><mxGeometry x="80" y="2020" width="1600" height="1880" as="geometry" /></mxCell><mxCell id="tk_1" value="1. Create Task Definition&lt;br&gt;Define clear purpose, deliverables,&lt;br&gt;due date, and acceptance criteria" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFAF0;strokeColor=#DD6B20;fontColor=#7B341E;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;fontStyle=1;" parent="p1_box" vertex="1"><mxGeometry x="40" y="60" width="340" height="75" as="geometry" /></mxCell><mxCell id="tk_2" value="2. Workload &amp; Availability Check&lt;br&gt;Evaluate staff capacity, active queues,&lt;br&gt;and current attendance status" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFAF0;strokeColor=#DD6B20;fontColor=#7B341E;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="p1_box" vertex="1"><mxGeometry x="420" y="60" width="360" height="75" as="geometry" /></mxCell><mxCell id="tk_3" value="3. Assign Employee &amp; Set Reviewer&lt;br&gt;Status: ASSIGNED / PENDING&lt;br&gt;Push notification to employee queue" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFAF0;strokeColor=#DD6B20;fontColor=#7B341E;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;fontStyle=1;" parent="p1_box" vertex="1"><mxGeometry x="820" y="60" width="360" height="75" as="geometry" /></mxCell><mxCell id="tk_4" value="4. Employee Opens Task Queue&lt;br&gt;Review instructions, deadlines,&lt;br&gt;and confirm deliverable scope" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0FFF4;strokeColor=#38A169;fontColor=#1C4532;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="p1_box" vertex="1"><mxGeometry x="1220" y="60" width="340" height="75" as="geometry" /></mxCell><mxCell id="tk_5" value="5. Start Execution&lt;br&gt;Status: IN PROGRESS&lt;br&gt;Work commences on task" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0FFF4;strokeColor=#38A169;fontColor=#1C4532;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;fontStyle=1;" parent="p1_box" vertex="1"><mxGeometry x="1220" y="180" width="340" height="70" as="geometry" /></mxCell><mxCell id="tk_6" value="6. Log Progress &amp; Work Activity&lt;br&gt;Record progress %, work notes, time entry&lt;br&gt;Attach versioned evidence files (v1.0, etc.)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0FFF4;strokeColor=#38A169;fontColor=#1C4532;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="p1_box" vertex="1"><mxGeometry x="820" y="180" width="360" height="70" as="geometry" /></mxCell><mxCell id="tk_7" value="7. Submit Work for Verification&lt;br&gt;Status: WAITING FOR REVIEW&lt;br&gt;Deliverables locked; notify manager" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0FFF4;strokeColor=#38A169;fontColor=#1C4532;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;fontStyle=1;" parent="p1_box" vertex="1"><mxGeometry x="420" y="180" width="360" height="70" as="geometry" /></mxCell><mxCell id="tk_8" value="8. Manager Review &amp; Audit&lt;br&gt;Status: UNDER REVIEW&lt;br&gt;Inspect submission against criteria" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFAF0;strokeColor=#DD6B20;fontColor=#7B341E;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="p1_box" vertex="1"><mxGeometry x="40" y="180" width="340" height="70" as="geometry" /></mxCell><mxCell id="tk_dec" value="Deliverables&lt;br&gt;Approved?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEFCBF;strokeColor=#D69E2E;fontColor=#744210;fontSize=12;fontStyle=1;spacing=6;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="p1_box" vertex="1"><mxGeometry x="120" y="290" width="180" height="100" as="geometry" /></mxCell><mxCell id="tk_close" value="APPROVED &amp; CLOSED&lt;br&gt;&lt;b&gt;Work Completed Successfully&lt;/b&gt;&lt;br&gt;Retain delivery history &amp; audit stamp" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0FFF4;strokeColor=#38A169;fontColor=#1C4532;fontSize=13;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;fontStyle=1;" parent="p1_box" vertex="1"><mxGeometry x="40" y="440" width="340" height="75" as="geometry" /></mxCell><mxCell id="tk_revise" value="CHANGES REQUESTED&lt;br&gt;&lt;b&gt;Manager Enters Specific Feedback&lt;/b&gt;&lt;br&gt;Returned to employee queue for revision" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#E53E3E;fontColor=#9B2C2C;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;fontStyle=1;" parent="p1_box" vertex="1"><mxGeometry x="420" y="302" width="360" height="75" as="geometry" /></mxCell><mxCell id="tk_resubmit" value="Employee Revises Deliverables&lt;br&gt;Increment version (v1.1); resubmit for review" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0FFF4;strokeColor=#38A169;fontColor=#1C4532;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="p1_box" vertex="1"><mxGeometry x="820" y="302" width="360" height="75" as="geometry" /></mxCell><mxCell id="p1_rule_note" value="WORK ACTIVITY PRINCIPLE: Work notes, progress %, time spent, and uploaded evidence are historical activity records. They do not create spurious task states. Only legitimate lifecycle transitions change the status." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EDF2F7;strokeColor=#CBD5E0;fontColor=#4A5568;fontSize=11;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="p1_box" vertex="1"><mxGeometry x="40" y="560" width="1520" height="45" as="geometry" /></mxCell><mxCell id="edge_26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="tk_1" target="tk_2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="tk_2" target="tk_3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="tk_3" target="tk_4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="tk_4" target="tk_5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="tk_5" target="tk_6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="tk_6" target="tk_7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="tk_7" target="tk_8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="tk_8" target="tk_dec"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_34" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="tk_dec" target="tk_close"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_35" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="tk_dec" target="tk_revise"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="tk_revise" target="tk_resubmit"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_37" value="Resubmit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="tk_resubmit" target="tk_7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2_box" value="PIPELINE B • EXCEPTION HANDLING: OVERDUE, REASSIGNMENT &amp; BLOCKER RESOLUTION" style="swimlane;startSize=35;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#E53E3E;fontColor=#9B2C2C;fontSize=14;fontStyle=1;swimlaneFillColor=#FFF5F5;swimlaneLine=0;strokeWidth=2;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="sec_layer2" vertex="1"><mxGeometry x="1740" y="2020" width="1600" height="1880" as="geometry" /></mxCell><mxCell id="ex_ov_1" value="Task Approaching Deadline&lt;br&gt;Automated deadline reminder notification&lt;br&gt;pushed to employee and manager" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFAF0;strokeColor=#DD6B20;fontColor=#7B341E;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="p2_box" vertex="1"><mxGeometry x="40" y="60" width="460" height="75" as="geometry" /></mxCell><mxCell id="ex_ov_2" value="Deadline Reached While Unfinished&lt;br&gt;Status: OVERDUE (Exception Flag)&lt;br&gt;Record overdue age, priority, and owner" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#E53E3E;fontColor=#9B2C2C;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;fontStyle=1;" parent="p2_box" vertex="1"><mxGeometry x="540" y="60" width="480" height="75" as="geometry" /></mxCell><mxCell id="ex_ov_3" value="Manager Overdue Intervention&lt;br&gt;Assess reason: employee delay, external waiting,&lt;br&gt;or scope blockage; select resolution path" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFAF0;strokeColor=#DD6B20;fontColor=#7B341E;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="p2_box" vertex="1"><mxGeometry x="1060" y="60" width="480" height="75" as="geometry" /></mxCell><mxCell id="ex_ov_ext" value="Option A: Extend Deadline&lt;br&gt;Save legitimate reason + new target date&lt;br&gt;Retain original due date in history" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFAF0;strokeColor=#DD6B20;fontColor=#7B341E;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="p2_box" vertex="1"><mxGeometry x="1060" y="180" width="480" height="75" as="geometry" /></mxCell><mxCell id="ex_re_1" value="Option B: Controlled Reassignment&lt;br&gt;Task requires rebalancing or reallocation&lt;br&gt;&lt;b&gt;*Preserve Existing Task ID throughout&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFAF0;strokeColor=#DD6B20;fontColor=#7B341E;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;fontStyle=1;" parent="p2_box" vertex="1"><mxGeometry x="540" y="180" width="480" height="75" as="geometry" /></mxCell><mxCell id="ex_re_2" value="Check Capacity &amp; Assign New Owner&lt;br&gt;Record transfer reason; handover notes&lt;br&gt;Notify previous and newly assigned owner" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFAF0;strokeColor=#DD6B20;fontColor=#7B341E;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="p2_box" vertex="1"><mxGeometry x="40" y="180" width="460" height="75" as="geometry" /></mxCell><mxCell id="ex_blk_1" value="Encounter Blocker / Impediment&lt;br&gt;Employee raises linked Blocker Ticket&lt;br&gt;Specify severity, details, and impact" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#E53E3E;fontColor=#9B2C2C;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;fontStyle=1;" parent="p2_box" vertex="1"><mxGeometry x="40" y="300" width="460" height="75" as="geometry" /></mxCell><mxCell id="ex_blk_2" value="Task Paused • Status: BLOCKED&lt;br&gt;Notify responsible manager immediately&lt;br&gt;Work halted until blocker resolution" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#E53E3E;fontColor=#9B2C2C;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="p2_box" vertex="1"><mxGeometry x="540" y="300" width="480" height="75" as="geometry" /></mxCell><mxCell id="ex_blk_3" value="Manager Evaluates Blocker&lt;br&gt;Can manager resolve internally?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEFCBF;strokeColor=#D69E2E;fontColor=#744210;fontSize=12;fontStyle=1;spacing=6;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="p2_box" vertex="1"><mxGeometry x="1060" y="287" width="180" height="100" as="geometry" /></mxCell><mxCell id="ex_blk_res" value="Internal Resolution&lt;br&gt;Manager unblocks resources/guidance&lt;br&gt;Mark Blocker Resolved → Resume Work" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0FFF4;strokeColor=#38A169;fontColor=#1C4532;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="p2_box" vertex="1"><mxGeometry x="1280" y="300" width="260" height="75" as="geometry" /></mxCell><mxCell id="ex_blk_esc" value="Escalate to Higher Authority&lt;br&gt;Technical issue → IT Analyst&lt;br&gt;High-impact business issue → Senior Mgr / GM" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#E53E3E;fontColor=#9B2C2C;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;fontStyle=1;" parent="p2_box" vertex="1"><mxGeometry x="1060" y="420" width="480" height="75" as="geometry" /></mxCell><mxCell id="ex_blk_track" value="Track Escalation in Chairman Dashboard&lt;br&gt;Appears in 'Requires Attention' interface&lt;br&gt;Unresolved blockers tracked until closed" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#805AD5;fontColor=#44337A;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;fontStyle=1;" parent="p2_box" vertex="1"><mxGeometry x="540" y="420" width="480" height="75" as="geometry" /></mxCell><mxCell id="p2_rule_note" value="EXCEPTION INTEGRITY RULE: Tasks NEVER disappear when deadlines expire. Overdue is an exception state requiring active decision-making. Reassignment transfers ownership under the same Task ID—it never deletes the old task to create a new one." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EDF2F7;strokeColor=#CBD5E0;fontColor=#4A5568;fontSize=11;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="p2_box" vertex="1"><mxGeometry x="40" y="560" width="1520" height="45" as="geometry" /></mxCell><mxCell id="edge_38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="ex_ov_1" target="ex_ov_2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="ex_ov_2" target="ex_ov_3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_40" value="Extend" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="ex_ov_3" target="ex_ov_ext"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_41" value="Reassign" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="ex_ov_3" target="ex_re_1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="ex_re_1" target="ex_re_2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="ex_blk_1" target="ex_blk_2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="ex_blk_2" target="ex_blk_3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_45" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="ex_blk_3" target="ex_blk_res"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_46" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="ex_blk_3" target="ex_blk_esc"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="ex_blk_esc" target="ex_blk_track"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p3_box" value="PIPELINE C • COMMERCIAL DEALS, 7.5% ROYALTY RECONCILIATION &amp; PEOPLE SERVICES" style="swimlane;startSize=35;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#805AD5;fontColor=#44337A;fontSize=14;fontStyle=1;swimlaneFillColor=#FAF5FF;swimlaneLine=0;strokeWidth=2;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="sec_layer2" vertex="1"><mxGeometry x="3400" y="2020" width="1600" height="1880" as="geometry" /></mxCell><mxCell id="cm_1" value="Commercial Deal Initiated in CIRIL CRM&lt;br&gt;Lead Giver member office records client requirement,&lt;br&gt;vertical, geography, and agreed fee sharing ratio" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#805AD5;fontColor=#44337A;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="p3_box" vertex="1"><mxGeometry x="40" y="60" width="460" height="75" as="geometry" /></mxCell><mxCell id="cm_2" value="Lead Routing &amp; Acceptance&lt;br&gt;Receiving member office accepts lead;&lt;br&gt;negotiation and client site inspections proceed" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#805AD5;fontColor=#44337A;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="p3_box" vertex="1"><mxGeometry x="540" y="60" width="480" height="75" as="geometry" /></mxCell><mxCell id="cm_3" value="Deal Concluded &amp; Brokerage Breakdown&lt;br&gt;Lease: ROUND(rate × area × lease days ÷ 30)&lt;br&gt;Sale: ROUND(1% × outright rate × area)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#805AD5;fontColor=#44337A;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="p3_box" vertex="1"><mxGeometry x="1060" y="60" width="480" height="75" as="geometry" /></mxCell><mxCell id="cm_4" value="Calculate CIRIL 7.5% Royalty&lt;br&gt;&lt;b&gt;Royalty = ROUND(7.5% × LG + 7.5% × LR)&lt;/b&gt;&lt;br&gt;Lead Manager (Manasa) follows up with offices" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#805AD5;fontColor=#44337A;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;fontStyle=1;" parent="p3_box" vertex="1"><mxGeometry x="1060" y="180" width="480" height="75" as="geometry" /></mxCell><mxCell id="cm_5" value="Accounts &amp; Finance Verification&lt;br&gt;Verify payment proof &amp; tax invoices;&lt;br&gt;reconcile royalty received vs. pending" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#805AD5;fontColor=#44337A;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="p3_box" vertex="1"><mxGeometry x="540" y="180" width="480" height="75" as="geometry" /></mxCell><mxCell id="cm_6" value="Reconcile into IOTS Records&lt;br&gt;Feed deal flow status into Executive Analytics&lt;br&gt;Chairman tracks 7.5% royalty collection health" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#805AD5;fontColor=#44337A;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;fontStyle=1;" parent="p3_box" vertex="1"><mxGeometry x="40" y="180" width="460" height="75" as="geometry" /></mxCell><mxCell id="peo_1" value="Attendance Punch (Check-In / Out)&lt;br&gt;Record in/out timestamps, calculate work hours,&lt;br&gt;validate geofence context for daily presence" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3182CE;fontColor=#1A365D;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="p3_box" vertex="1"><mxGeometry x="40" y="300" width="460" height="75" as="geometry" /></mxCell><mxCell id="peo_2" value="Employee 10-State Availability Flags&lt;br&gt;Available • Busy • In Meeting • On Break • Training&lt;br&gt;DND • Remote • On Leave • Absent • Offline" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3182CE;fontColor=#1A365D;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="p3_box" vertex="1"><mxGeometry x="540" y="300" width="480" height="75" as="geometry" /></mxCell><mxCell id="peo_3" value="Self-Service Requests Workflow&lt;br&gt;Leave • Permission • Resource • Guidance&lt;br&gt;Routed to Manager for approval / rejection" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3182CE;fontColor=#1A365D;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="p3_box" vertex="1"><mxGeometry x="1060" y="300" width="480" height="75" as="geometry" /></mxCell><mxCell id="peo_4" value="Event-Driven Notifications Engine&lt;br&gt;New task assigned • Deadline reminder • Overdue flag&lt;br&gt;Review feedback • Request decision • Announcement" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3182CE;fontColor=#1A365D;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="p3_box" vertex="1"><mxGeometry x="540" y="420" width="480" height="75" as="geometry" /></mxCell><mxCell id="p3_rule_note" value="COMMERCIAL INTEGRITY RULE: CIRIL CRM owns lead records and commercial transactions. IOTS tracks HYD coordination tasks, follow-up accountability, evidence collection, and 7.5% royalty health monitoring for the Chairman." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EDF2F7;strokeColor=#CBD5E0;fontColor=#4A5568;fontSize=11;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="p3_box" vertex="1"><mxGeometry x="40" y="560" width="1520" height="45" as="geometry" /></mxCell><mxCell id="edge_48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="cm_1" target="cm_2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="cm_2" target="cm_3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="cm_3" target="cm_4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_51" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="cm_4" target="cm_5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_52" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="cm_5" target="cm_6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_53" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="peo_1" target="peo_2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_54" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="peo_2" target="peo_3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_55" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="peo_3" target="peo_4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="sec_data_bridge" value="CENTRAL DATA BRIDGE • SHARED OPERATIONAL RECORDS &amp; IMMUTABLE SYSTEM AUDIT LOG" style="swimlane;startSize=40;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#553C9A;fontColor=#FFFFFF;fontSize=14;fontStyle=1;swimlaneFillColor=#FAF5FF;swimlaneLine=0;strokeWidth=2;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="1" vertex="1"><mxGeometry x="60" y="4950" width="5080" height="360" as="geometry" /></mxCell><mxCell id="db_audit" value="IMMUTABLE AUDIT LOG&lt;br&gt;Every action captures:&lt;br&gt;• Employee Identity&lt;br&gt;• Active Role Context&lt;br&gt;• Timestamp &amp; GPS&lt;br&gt;• Action &amp; Object&lt;br&gt;• Before / After State&lt;br&gt;• Completely Tamper-Proof" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#805AD5;fontColor=#44337A;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;fontStyle=1;" parent="sec_data_bridge" vertex="1"><mxGeometry x="100" y="60" width="1400" height="140" as="geometry" /></mxCell><mxCell id="db_store" value="CENTRAL OPERATIONAL ACTIVITY STORE&lt;br&gt;Shared Normalized Database Capturing All System Activity:&lt;br&gt;User Profiles • Geofence Perimeters • Task Lifecycle Events • Revision Versions&lt;br&gt;Time / Effort Logs • Uploaded Evidence • Attendance Records • Requests &amp; Decisions&lt;br&gt;CRM Deal Reconciliations • 7.5% Royalty Collections • Company Announcements" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#553C9A;strokeColor=#44337A;fontColor=#FFFFFF;fontSize=13;fontStyle=1;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="sec_data_bridge" vertex="1"><mxGeometry x="1600" y="60" width="1900" height="140" as="geometry" /></mxCell><mxCell id="db_guarantee" value="SYSTEM ARCHITECTURAL GUARANTEES&lt;br&gt;• Single Task Identity: One ID preserved across all transfers/extensions&lt;br&gt;• Append-Only Activities: Work notes &amp; evidence don't alter state&lt;br&gt;• Session Segregation: Audit log isolates role context per transaction&lt;br&gt;• Reassignment Integrity: Transfers retain full previous ownership history" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#805AD5;fontColor=#44337A;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;fontStyle=1;" parent="sec_data_bridge" vertex="1"><mxGeometry x="3600" y="60" width="1400" height="140" as="geometry" /></mxCell><mxCell id="edge_56" value="Record Task Closures &amp; Evidence" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.2;entryY=0;" parent="1" edge="1" source="p1_box" target="db_store"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_57" value="Record Overdue &amp; Reassignment Events" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" edge="1" source="p2_box" target="db_store"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_58" value="Record Attendance, Requests &amp; Royalty Status" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.8;entryY=0;" parent="1" edge="1" source="p3_box" target="db_store"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="sec_layer3" value="LAYER 3 • INTELLIGENCE, ANALYTICS &amp; EXECUTIVE OVERSIGHT LAYER" style="swimlane;startSize=45;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F7FAFC;strokeColor=#44337A;fontColor=#FFFFFF;fontSize=14;fontStyle=1;swimlaneFillColor=#F7FAFC;swimlaneLine=0;strokeWidth=2;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="1" vertex="1"><mxGeometry x="60" y="5340" width="5080" height="2140" as="geometry" /></mxCell><mxCell id="edge_59" value="ETL Stream: Feed Verified Operational Records" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" edge="1" source="db_store" target="sec_layer3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="eng_1" value="1. PERFORMANCE ANALYTICS&lt;br&gt;• Task completion rate (counts &amp; %)&lt;br&gt;• On-time delivery vs. late completions&lt;br&gt;• Elapsed calendar time vs. active effort&lt;br&gt;• Individual, manager &amp; team productivity" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EBF8FF;strokeColor=#3182CE;fontColor=#1A365D;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;fontStyle=1;" parent="sec_layer3" vertex="1"><mxGeometry x="80" y="70" width="790" height="110" as="geometry" /></mxCell><mxCell id="eng_2" value="2. WORKLOAD &amp; CAPACITY&lt;br&gt;• Active, assigned, blocked &amp; review queues&lt;br&gt;• Individual vs. team capacity utilization&lt;br&gt;• Overdue task aging distribution by owner&lt;br&gt;• Workload balancing &amp; bottleneck alerts" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFAF0;strokeColor=#DD6B20;fontColor=#7B341E;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;fontStyle=1;" parent="sec_layer3" vertex="1"><mxGeometry x="900" y="70" width="790" height="110" as="geometry" /></mxCell><mxCell id="eng_3" value="3. ATTENDANCE &amp; LOCATION&lt;br&gt;• Punctuality, tardiness &amp; absence trends&lt;br&gt;• Approved leaves separated from unexcused&lt;br&gt;• Remote vs. unknown location jump trends&lt;br&gt;• Work hour calculations &amp; shift compliance" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0FFF4;strokeColor=#38A169;fontColor=#1C4532;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;fontStyle=1;" parent="sec_layer3" vertex="1"><mxGeometry x="1720" y="70" width="790" height="110" as="geometry" /></mxCell><mxCell id="eng_4" value="4. EXCEPTION &amp; RISK HEATMAPS&lt;br&gt;• Chronic task reassignment clusters&lt;br&gt;• Unresolved departmental blocker tickets&lt;br&gt;• SLA breach probabilities on key verticals&lt;br&gt;• Low / Medium / High severity risk matrix" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#E53E3E;fontColor=#9B2C2C;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;fontStyle=1;" parent="sec_layer3" vertex="1"><mxGeometry x="2540" y="70" width="790" height="110" as="geometry" /></mxCell><mxCell id="eng_5" value="5. HISTORICAL TRAJECTORIES&lt;br&gt;• Day-over-day operational throughput&lt;br&gt;• Week-over-week team velocity changes&lt;br&gt;• Month-over-month target achievement&lt;br&gt;• Comparative trend tracking over quarters" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#805AD5;fontColor=#44337A;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;fontStyle=1;" parent="sec_layer3" vertex="1"><mxGeometry x="3360" y="70" width="790" height="110" as="geometry" /></mxCell><mxCell id="eng_6" value="6. COMMERCIAL &amp; RECOGNITION&lt;br&gt;• Commercial deal velocity &amp; pipeline size&lt;br&gt;• 7.5% royalty health (due vs. collected)&lt;br&gt;• Monthly KPI standings by employee role&lt;br&gt;• 3-month excellence commendation tracking" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FEFCBF;strokeColor=#D69E2E;fontColor=#744210;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;fontStyle=1;" parent="sec_layer3" vertex="1"><mxGeometry x="4180" y="70" width="790" height="110" as="geometry" /></mxCell><mxCell id="rep_banner" value="REPORT GENERATION ENGINE • SCOPED AUTOMATED EXPORTS ACROSS REPORTING PERIODS" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EDF2F7;strokeColor=#CBD5E0;fontColor=#2D3748;fontSize=13;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;fontStyle=1;" parent="sec_layer3" vertex="1"><mxGeometry x="80" y="205" width="4920" height="40" as="geometry" /></mxCell><mxCell id="rep_daily" value="DAILY OPERATIONAL DIGEST&lt;br&gt;• Today's completed tasks &amp; active deliverables&lt;br&gt;• Newly overdue tasks &amp; active blocker tickets&lt;br&gt;• Daily attendance summary &amp; off-site location flags" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A5568;fontColor=#1A202C;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="sec_layer3" vertex="1"><mxGeometry x="80" y="260" width="1600" height="80" as="geometry" /></mxCell><mxCell id="rep_weekly" value="WEEKLY MANAGEMENT SUMMARY&lt;br&gt;• Team delivery throughput &amp; on-time percentages&lt;br&gt;• Workload distribution &amp; capacity rebalancing needs&lt;br&gt;• Deal coordination progress &amp; blocker resolution rates" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A5568;fontColor=#1A202C;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="sec_layer3" vertex="1"><mxGeometry x="1740" y="260" width="1600" height="80" as="geometry" /></mxCell><mxCell id="rep_monthly" value="MONTHLY / PERIOD APPRAISAL REPORT&lt;br&gt;• Role-specific KPI achievement against baselines&lt;br&gt;• Monthly performance standing calculations&lt;br&gt;• Comprehensive appraisal report format exports (PDF/Excel)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A5568;fontColor=#1A202C;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="sec_layer3" vertex="1"><mxGeometry x="3400" y="260" width="1600" height="80" as="geometry" /></mxCell><mxCell id="dash_banner" value="ROLE-BASED DASHBOARD PROJECTIONS • DYNAMIC DATA VIEWS FILTERED BY ACTIVE ROLE CONTEXT" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EDF2F7;strokeColor=#CBD5E0;fontColor=#2D3748;fontSize=13;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;fontStyle=1;" parent="sec_layer3" vertex="1"><mxGeometry x="80" y="360" width="4920" height="40" as="geometry" /></mxCell><mxCell id="dash_80" value="&lt;b&gt;CHAIRMAN (Vijay Sir)&lt;/b&gt;&lt;br&gt;Bird's-eye enterprise health, 7.5% royalty collections, attendance summaries, 'Requires Attention' cluster, award sign-off" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#718096;fontColor=#1A202C;fontSize=11;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="sec_layer3" vertex="1"><mxGeometry x="80" y="415" width="960" height="75" as="geometry" /></mxCell><mxCell id="dash_1070" value="&lt;b&gt;GENERAL MANAGER&lt;/b&gt;&lt;br&gt;Branch operations, Board items, statutory audit compliance, finance tracking, prospective member discussions" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#718096;fontColor=#1A202C;fontSize=11;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="sec_layer3" vertex="1"><mxGeometry x="1070" y="415" width="960" height="75" as="geometry" /></mxCell><mxCell id="dash_2060" value="&lt;b&gt;SENIOR MANAGER&lt;/b&gt;&lt;br&gt;Cross-team capacity balancing, SLA/deadline risk mitigation, high-impact escalation approval queue, comparative stats" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#718096;fontColor=#1A202C;fontSize=11;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="sec_layer3" vertex="1"><mxGeometry x="2060" y="415" width="960" height="75" as="geometry" /></mxCell><mxCell id="dash_3050" value="&lt;b&gt;LEAD MANAGER (Manasa)&lt;/b&gt;&lt;br&gt;Own vertical team queues, deal royalty follow-up, Retail/L&amp;W/Land/Hotel calls, Bitra website updates, lead exchange" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#718096;fontColor=#1A202C;fontSize=11;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="sec_layer3" vertex="1"><mxGeometry x="3050" y="415" width="960" height="75" as="geometry" /></mxCell><mxCell id="dash_4040" value="&lt;b&gt;SUPER ADMIN&lt;/b&gt;&lt;br&gt;Platform governance, master organization config, RBAC security, high-level account control, compliance audit viewer" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#718096;fontColor=#1A202C;fontSize=11;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="sec_layer3" vertex="1"><mxGeometry x="4040" y="415" width="960" height="75" as="geometry" /></mxCell><mxCell id="dash_80_b" value="&lt;b&gt;IT SYSTEM ANALYST&lt;/b&gt;&lt;br&gt;Technical infrastructure, server uptime, API rate limits, database deadlocks, anomalous login security logs, bug fixes" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#718096;fontColor=#1A202C;fontSize=11;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="sec_layer3" vertex="1"><mxGeometry x="80" y="500" width="960" height="75" as="geometry" /></mxCell><mxCell id="dash_1070_b" value="&lt;b&gt;ADMIN&lt;/b&gt;&lt;br&gt;User profile provisioning, approved geofence perimeter coordinates, attendance exceptions, global queue cleanup, announcements" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#718096;fontColor=#1A202C;fontSize=11;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="sec_layer3" vertex="1"><mxGeometry x="1070" y="500" width="960" height="75" as="geometry" /></mxCell><mxCell id="dash_2060_b" value="&lt;b&gt;EXECUTIVE&lt;/b&gt;&lt;br&gt;Personal assigned work queue, time &amp; progress entry, evidence attachment, blocker raising, manager revision cycles" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#718096;fontColor=#1A202C;fontSize=11;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="sec_layer3" vertex="1"><mxGeometry x="2060" y="500" width="960" height="75" as="geometry" /></mxCell><mxCell id="dash_3050_b" value="&lt;b&gt;BDE (Bhavani)&lt;/b&gt;&lt;br&gt;Prospect broker research, Upturnly &amp; 99acres portal queues, WhatsApp outreach campaigns, cold calling logs, follow-up queue" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#718096;fontColor=#1A202C;fontSize=11;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="sec_layer3" vertex="1"><mxGeometry x="3050" y="500" width="960" height="75" as="geometry" /></mxCell><mxCell id="dash_4040_b" value="&lt;b&gt;CREATIVES ASSOCIATE (Harshitha)&lt;/b&gt;&lt;br&gt;Social media channels, content pipeline (Brief→Published), v1.0/v1.1 graphics versioning, Office calls, report proofreading" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#718096;fontColor=#1A202C;fontSize=11;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="sec_layer3" vertex="1"><mxGeometry x="4040" y="500" width="960" height="75" as="geometry" /></mxCell><mxCell id="ch_container" value="CHAIRMAN EXECUTIVE INTERFACE • STRATEGIC OVERSIGHT &amp; GOVERNANCE (Vijay Sir)" style="swimlane;startSize=40;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFF0;strokeColor=#B7791F;fontColor=#744210;fontSize=14;fontStyle=1;swimlaneFillColor=#FFFFF0;swimlaneLine=0;strokeWidth=2;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;" parent="sec_layer3" vertex="1"><mxGeometry x="80" y="600" width="4920" height="650" as="geometry" /></mxCell><mxCell id="ch_panel_1" value="1. BIRD'S-EYE OPERATIONAL &amp; COMMERCIAL INTELLIGENCE&lt;br&gt;• Complete visibility across HYD branch and multi-office coordination&lt;br&gt;• Monitors high-level commercial deal flow &amp; 7.5% royalty health&lt;br&gt;• Inspects company-wide attendance audits, remote/unknown GPS trends&lt;br&gt;• Evaluates vertical performance trends (Retail, Land, Hotel, Logistics)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D69E2E;fontColor=#744210;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;fontStyle=1;" parent="ch_container" vertex="1"><mxGeometry x="40" y="60" width="1560" height="130" as="geometry" /></mxCell><mxCell id="ch_panel_2" value="2. EXECUTIVE 'REQUIRES ATTENTION' INTERFACE&lt;br&gt;• Real-time aggregation of systemic operational bottlenecks:&lt;br&gt;  - Overdue task clusters missing client/member deadlines&lt;br&gt;  - Repeated task reassignments signaling capability/capacity failure&lt;br&gt;  - Unresolved departmental blocker tickets escalated from managers&lt;br&gt;• Inspect underlying evidence &amp; direct follow-ups to responsible GM/Managers" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#E53E3E;fontColor=#9B2C2C;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;fontStyle=1;" parent="ch_container" vertex="1"><mxGeometry x="1660" y="60" width="1600" height="130" as="geometry" /></mxCell><mxCell id="ch_panel_3" value="3. QUARTERLY REWARD, RECOGNITION &amp; ANNOUNCEMENTS&lt;br&gt;• Reviews monthly performance standings across verified objective KPIs&lt;br&gt;• Personally signs off on 3-consecutive-month excellence commendations&lt;br&gt;• Publishes official enterprise-wide announcements to all workspaces&lt;br&gt;• Exports comprehensive employee reports in tailored appraisal formats" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D69E2E;fontColor=#744210;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;fontStyle=1;" parent="ch_container" vertex="1"><mxGeometry x="3320" y="60" width="1560" height="130" as="geometry" /></mxCell><mxCell id="ch_governance_boundary" value="CHAIRMAN STRATEGIC GOVERNANCE BOUNDARY:&lt;br&gt;Vijay Sir holds executive bird's-eye oversight, strategic intervention authority, appraisal sign-off, and company-wide broadcast rights. In accordance with system governance, the Chairman CANNOT reset routine employee passwords or perform everyday task reassignments—operational delegation remains strictly with authorized Admins and Lead/Senior Managers." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFF0;strokeColor=#B7791F;fontColor=#744210;fontSize=13;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;fontStyle=1;" parent="ch_container" vertex="1"><mxGeometry x="40" y="210" width="4840" height="60" as="geometry" /></mxCell><mxCell id="edge_60" value="Escalate Overdue Clusters" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="rep_daily" target="ch_panel_2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_61" value="Feed Operational Summaries" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="rep_weekly" target="ch_panel_1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_62" value="Feed Monthly KPI Standings" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Segoe UI, Arial;fontSize=11;strokeColor=#4A5568;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="rep_monthly" target="ch_panel_3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ftr_main" value="CIRIL INTERNAL OPERATIONS TRACKING SYSTEM (IOTS) • ARCHITECTURAL COMPLIANCE VERIFICATION&lt;br&gt;Designed strictly adhering to ciril_crm_detail.pdf, Construct.txt, and system requirements. Unifies 10 organizational roles, provides dynamic multi-role context switching, enforces zero orphaned tasks, guarantees single immutable task identity, reconciles 7.5% commercial royalties, and delivers real-time executive intelligence for the Chairman." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#1A365D;strokeColor=#1A365D;fontColor=#FFFFFF;fontSize=12;spacing=8;strokeWidth=1.5;fontFamily=Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="60" y="7500" width="5080" height="50" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>