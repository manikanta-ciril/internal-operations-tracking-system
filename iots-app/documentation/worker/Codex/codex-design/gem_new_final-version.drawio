          <mxGeometry height="75" width="560" x="3140" y="3530" as="geometry" />
        </mxCell>
        <mxCell id="new-379" parent="layer2" style="whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=17;spacing=10;strokeWidth=1.5;rhombus;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#152735;" value="&lt;b&gt;Approved?&lt;/b&gt;" vertex="1">
          <mxGeometry height="75" width="440" x="3200" y="3635" as="geometry" />
        </mxCell>
        <mxCell id="new-381" parent="layer2" style="whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=17;spacing=10;strokeWidth=1.5;rounded=1;arcSize=10;fillColor=#E8F5EF;strokeColor=#2D7B5C;fontColor=#152735;" value="&lt;b&gt;Complete &amp; Close Task&lt;/b&gt;&lt;br&gt;Record approval and final evidence" vertex="1">
          <mxGeometry height="75" width="560" x="3140" y="3780" as="geometry" />
        </mxCell>
        <mxCell id="new-383" parent="layer2" style="whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=17;spacing=10;strokeWidth=1.5;rounded=1;arcSize=10;fillColor=#FBEDED;strokeColor=#B35C65;fontColor=#152735;" value="&lt;b&gt;Changes Requested&lt;/b&gt;&lt;br&gt;Manager records corrections; notify employee" vertex="1">
          <mxGeometry height="75" width="550" x="3730" y="3635" as="geometry" />
        </mxCell>
        <mxCell id="new-385" parent="layer2" style="whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=17;spacing=10;strokeWidth=1.5;rounded=1;arcSize=10;fillColor=#E8F5EF;strokeColor=#2D7B5C;fontColor=#152735;" value="&lt;b&gt;Employee Revises &amp; Resubmits&lt;/b&gt;&lt;br&gt;Preserve previous versions and feedback" vertex="1">
          <mxGeometry height="75" width="550" x="3730" y="3780" as="geometry" />
        </mxCell>
        <mxCell id="new-388" parent="layer2" style="whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=16;spacing=12;strokeWidth=1.5;rounded=1;arcSize=8;align=left;fillColor=#F5F7FA;strokeColor=#728294;fontColor=#152735;" value="&lt;b&gt;WORK ACTIVITY ≠ TASK STATE&lt;/b&gt;&lt;br&gt;Progress updates, work notes, effort entries and files are historical activity records. A reassignment is an ownership-change event; overdue is an exception flag on unfinished work. Cancellation is a separately authorised outcome.&lt;br&gt;&lt;br&gt;&lt;b&gt;State Machine Invariant:&lt;/b&gt; Task states (Assigned → In Progress → Waiting for Review → Under Review → Closed) are strictly controlled by formal lifecycle transitions, never mutated directly by note additions or file uploads." vertex="1">
          <mxGeometry height="260" width="1976" x="112" y="3320" as="geometry" />
        </mxCell>
        <mxCell id="new-389" parent="layer2" style="whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=16;spacing=12;strokeWidth=1.5;rounded=1;arcSize=8;align=left;fillColor=#F5F7FA;strokeColor=#728294;fontColor=#152735;" value="&lt;b&gt;BUSINESS LINKAGE&lt;/b&gt;&lt;br&gt;Member office / CRM lead / campaign / conference / IT incident references connect operational tasks to their business context. External parties provide inputs; IOTS records staff coordination and accountability.&lt;br&gt;&lt;br&gt;&lt;b&gt;Traceability Contract:&lt;/b&gt; Every task links to its originating business entity ID, ensuring end-to-end auditability across departments." vertex="1">
          <mxGeometry height="260" width="1976" x="112" y="3600" as="geometry" />
        </mxCell>
        <mxCell id="new-390" parent="layer2" style="whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=16;spacing=12;strokeWidth=1.5;rounded=1;arcSize=10;fillColor=#E8F5EF;strokeColor=#2D7B5C;fontColor=#152735;" value="&lt;b&gt;MEMBERSHIP WORK&lt;/b&gt;&lt;br&gt;BDE research → outreach → log response / next follow-up → GM meeting → agreement and fee coordination → review outcome.&lt;br&gt;Unready prospects remain in a dated follow-up queue." vertex="1">
          <mxGeometry height="165" width="1976" x="4512" y="3320" as="geometry" />
        </mxCell>
        <mxCell id="new-391" parent="layer2" style="whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=16;spacing=12;strokeWidth=1.5;rounded=1;arcSize=10;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#152735;" value="&lt;b&gt;MEMBER DEAL &amp; ROYALTY FOLLOW-UP&lt;/b&gt;&lt;br&gt;CRM lead → receiving member accepts / rejects → proposal / negotiation → concluded deal → brokerage acceptance → verified royalty payment.&lt;br&gt;IOTS tracks internal owners and evidence; unpaid amounts stay open." vertex="1">
          <mxGeometry height="165" width="1976" x="4512" y="3505" as="geometry" />
        </mxCell>
        <mxCell id="new-392" parent="layer2" style="whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=16;spacing=12;strokeWidth=1.5;rounded=1;arcSize=10;fillColor=#E8F5EF;strokeColor=#2D7B5C;fontColor=#152735;" value="&lt;b&gt;CREATIVE &amp; RESEARCH DELIVERY&lt;/b&gt;&lt;br&gt;Brief / member research data → draft / proofread / design → review → corrections → approval → publish / print → evidence.&lt;br&gt;Retain versions, final links and distribution records." vertex="1">
          <mxGeometry height="165" width="1976" x="4512" y="3690" as="geometry" />
        </mxCell>
        <mxCell id="new-393" parent="layer2" style="whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=17;spacing=10;strokeWidth=1.5;rounded=1;fontStyle=1;fontSize=24;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#152735;" value="OVERDUE &amp; REASSIGNMENT" vertex="1">
          <mxGeometry height="64" width="2000" x="100" y="3900" as="geometry" />
