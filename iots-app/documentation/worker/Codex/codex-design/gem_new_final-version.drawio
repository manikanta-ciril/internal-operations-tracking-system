          <mxGeometry height="78" width="1976" x="112" y="4000" as="geometry" />
        </mxCell>
        <mxCell id="new-395" parent="layer2" style="whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=17;spacing=10;strokeWidth=1.5;rounded=1;arcSize=10;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#152735;" value="Manager reviews priority, impact, blocker and review-waiting context" vertex="1">
