exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="people-n307" target="people-n308"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="people-e314" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#C66B17;strokeWidth=1.4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="people-n308" target="people-n309"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="people-e315" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#C66B17;strokeWidth=1.4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="people-n309" target="people-n310"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="people-e323" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#32749A;strokeWidth=1.4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="people-n317" target="people-n318"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="people-e324" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#32749A;strokeWidth=1.4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="people-n318" target="people-n319"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="people-e325" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#32749A;strokeWidth=1.4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="people-n319" target="people-n320"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="people-e326" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#32749A;strokeWidth=1.4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="people-n320" target="people-n321"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="people-e327" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#32749A;strokeWidth=1.4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="people-n321" target="people-n322"><mxGeometry relative="1" as="geometry"/></mxCell><object id="people-n289" label="07 • Attendance, availability &amp; employee services"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;fontStyle=1;fontSize=19;fillColor=#19344A;strokeColor=#19344A;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1520" height="55" as="geometry"/></mxCell></object><object id="people-n290" label="LAYER 2 • Shared personal services remain available to authorised employees across role workspaces. Attendance, online sessions and task effort have separate records."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=0;strokeOpacity=0;align=left;fillColor=#F5F7FA;strokeColor=#6B7B8D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1520" height="45" as="geometry"/></mxCell></object><object id="people-n291" label="← OVERVIEW" link="data:page/id,overview"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1350" y="145" width="210" height="36" as="geometry"/></mxCell></object><object id="people-n292" label="ATTENDANCE &amp; AVAILABILITY"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;fontStyle=1;fontSize=19;fillColor=#E8F5EF;strokeColor=#2D7B5C;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="60" y="205" width="450" height="46" as="geometry"/></mxCell></object><object id="people-n293" label="Check in&lt;br&gt;Capture time and location context [02]"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#E8F5EF;strokeColor=#2D7B5C;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="72" y="277" width="426" height="78" as="geometry"/></mxCell></object><object id="people-n294" label="Record attendance&lt;br&gt;Apply configured shift / grace / leave rules"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#E8F5EF;strokeColor=#2D7B5C;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="72" y="412" width="426" height="78" as="geometry"/></mxCell></object><object id="people-n295" label="Set availability; update while working&lt;br&gt;Managers use it to assess capacity"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#E8F5EF;strokeColor=#2D7B5C;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="72" y="547" width="426" height="78" as="geometry"/></mxCell></object><object id="people-n296" label="Check out&lt;br&gt;Capture end time and recorded breaks"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#E8F5EF;strokeColor=#2D7B5C;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="72" y="682" width="426" height="78" as="geometry"/></mxCell></object><object id="people-n297" label="Complete timestamps?&lt;br&gt;If yes: calculate policy-based work hours"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#E8F5EF;strokeColor=#2D7B5C;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="72" y="817" width="426" height="78" as="geometry"/></mxCell></object><object id="people-n298" label="Store attendance history&lt;br&gt;Employee sees own; manager sees team"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#E8F5EF;strokeColor=#2D7B5C;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="72" y="952" width="426" height="78" as="geometry"/></mxCell></object><object id="people-n304" label="REQUEST &amp; SELF-SERVICE"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;fontStyle=1;fontSize=19;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="575" y="205" width="450" height="46" as="geometry"/></mxCell></object><object id="people-n305" label="Create request&lt;br&gt;Leave / permission / scheduled remote work"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="587" y="277" width="426" height="78" as="geometry"/></mxCell></object><object id="people-n306" label="Or request guidance / resources&lt;br&gt;Add dates, reason and supporting details"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="587" y="412" width="426" height="78" as="geometry"/></mxCell></object><object id="people-n307" label="Submit to designated authority&lt;br&gt;Notify reviewer; status Pending"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="587" y="547" width="426" height="78" as="geometry"/></mxCell></object><object id="people-n308" label="Review and record decision&lt;br&gt;Approved / Rejected / Returned for detail"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="587" y="682" width="426" height="78" as="geometry"/></mxCell></object><object id="people-n309" label="Notify employee; store decision history&lt;br&gt;Approved absence adjusts availability"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="587" y="817" width="426" height="78" as="geometry"/></mxCell></object><object id="people-n310" label="Manager adjusts workload if needed&lt;br&gt;Pending decisions remain in attention queue"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="587" y="952" width="426" height="78" as="geometry"/></mxCell></object><object id="people-n316" label="COMMUNICATION &amp; PROFILE"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;fontStyle=1;fontSize=19;fillColor=#EAF3F9;strokeColor=#32749A;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1090" y="205" width="450" height="46" as="geometry"/></mxCell></object><object id="people-n317" label="Operational event occurs&lt;br&gt;Assignment, deadline, feedback or decision"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#EAF3F9;strokeColor=#32749A;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1102" y="277" width="426" height="78" as="geometry"/></mxCell></object><object id="people-n318" label="Generate scoped notification&lt;br&gt;Task, reassignment, overdue or escalation"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#EAF3F9;strokeColor=#32749A;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1102" y="412" width="426" height="78" as="geometry"/></mxCell></object><object id="people-n319" label="Employee opens linked item&lt;br&gt;Reads instructions, responds or acts"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#EAF3F9;strokeColor=#32749A;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1102" y="547" width="426" height="78" as="geometry"/></mxCell></object><object id="people-n320" label="View personal activity &amp; performance&lt;br&gt;Completion, attendance, feedback history"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#EAF3F9;strokeColor=#32749A;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1102" y="682" width="426" height="78" as="geometry"/></mxCell></object><object id="people-n321" label="View profile / account details&lt;br&gt;Request controlled account changes"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#EAF3F9;strokeColor=#32749A;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1102" y="817" width="426" height="78" as="geometry"/></mxCell></object><object id="people-n322" label="Change password / review active sessions&lt;br&gt;Log out or end selected session"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#EAF3F9;strokeColor=#32749A;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1102" y="952" width="426" height="78" as="geometry"/></mxCell></object><object id="people-n328" label="Availability options&lt;br&gt;Available • Busy • In Meeting • On Break • In Training • Do Not Disturb • Working Remotely • On Leave • Absent • Offline&lt;br&gt;&lt;br&gt;Leave / absence labels follow approved records and attendance rules."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#E8F5EF;strokeColor=#2D7B5C;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="75" y="1150" width="430" height="175" as="geometry"/></mxCell></object><object id="people-n329" label="Exceptions&lt;br&gt;Missing checkout or inconsistent hours → correction request → authorised review → audit correction.&lt;br&gt;&lt;br&gt;Returned request → add details → resubmit. Rejection keeps reason and history."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FBEDED;strokeColor=#B35C65;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="590" y="1150" width="430" height="175" as="geometry"/></mxCell></object><object id="people-n330" label="Announcements&lt;br&gt;Admin / Chairman: permitted organisation audience. Manager: team audience.&lt;br&gt;&lt;br&gt;Schedule → publish → display to recipients → keep publication history."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#EAF3F9;strokeColor=#32749A;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1105" y="1150" width="430" height="175" as="geometry"/></mxCell></object><object id="people-n331" label="POLICY &amp; RECORD QUALITY"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;fontStyle=1;fontSize=19;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="40" y="1390" width="1520" height="40" as="geometry"/></mxCell></object><object id="people-n332" label="Recommended: checkout is explicit; session expiry or a closed browser does not silently declare a full day worked. Geolocation failure is an exception for review. Shift times, grace limits, breaks and remote-work approval remain configurable."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=0;strokeOpacity=0;align=left;fillColor=#F5F7FA;strokeColor=#6B7B8D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="40" y="1450" width="1520" height="70" as="geometry"/></mxCell></object></root></mxGraphModel></diagram><diagram id="technical" name="08 • IT reliability &amp; technical intervention"><mxGraphModel dx="1600" dy="1350" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1350" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="technical-e342" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#32749A;strokeWidth=1.4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="technical-n337" target="technical-n338"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="technical-e343" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#32749A;strokeWidth=1.4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="technical-n338" target="technical-n339"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="technical-e344" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#32749A;strokeWidth=1.4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="technical-n339" target="technical-n340"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="technical-e345" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#32749A;strokeWidth=1.4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="technical-n340" target="technical-n341"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="technical-e352" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#32749A;strokeWidth=1.4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="technical-n347" target="technical-n348"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="technical-e353" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#32749A;strokeWidth=1.4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="technical-n348" target="technical-n349"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="technical-e354" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#32749A;strokeWidth=1.4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="technical-n349" target="technical-n350"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="technical-e355" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#32749A;strokeWidth=1.4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="technical-n350" target="technical-n351"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="technical-e356" value="Incident" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#32749A;strokeWidth=1.4;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="technical-n341" target="technical-n347"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="technical-e363" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#32749A;strokeWidth=1.4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="technical-n358" target="technical-n359"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="technical-e364" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#32749A;strokeWidth=1.4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="technical-n359" target="technical-n360"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="technical-e365" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#32749A;strokeWidth=1.4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="technical-n360" target="technical-n361"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="technical-e366" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#32749A;strokeWidth=1.4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="technical-n361" target="technical-n362"><mxGeometry relative="1" as="geometry"/></mxCell><object id="technical-n333" label="08 • IT reliability &amp; technical intervention"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;fontStyle=1;fontSize=19;fillColor=#19344A;strokeColor=#19344A;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1520" height="55" as="geometry"/></mxCell></object><object id="technical-n334" label="LAYER 2 • IT System Analyst has the same platform privileges as Super Admin, with a technical workspace. Business approval still follows the designated business authority."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=0;strokeOpacity=0;align=left;fillColor=#F5F7FA;strokeColor=#6B7B8D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1520" height="45" as="geometry"/></mxCell></object><object id="technical-n335" label="← OVERVIEW" link="data:page/id,overview"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1350" y="145" width="210" height="36" as="geometry"/></mxCell></object><object id="technical-n336" label="MONITOR &amp; DIAGNOSE"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;fontStyle=1;fontSize=19;fillColor=#EAF3F9;strokeColor=#32749A;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="70" y="210" width="450" height="46" as="geometry"/></mxCell></object><object id="technical-n337" label="Monitor application and services&lt;br&gt;Uptime, database latency, frontend response"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#EAF3F9;strokeColor=#32749A;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="82" y="282" width="426" height="78" as="geometry"/></mxCell></object><object id="technical-n338" label="Inspect external service health&lt;br&gt;Geocoding, mail, storage &amp; rate limits"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#EAF3F9;strokeColor=#32749A;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="82" y="412" width="426" height="78" as="geometry"/></mxCell></object><object id="technical-n339" label="Review security events&lt;br&gt;Unusual logins, location jumps, timeouts"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#EAF3F9;strokeColor=#32749A;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="82" y="542" width="426" height="78" as="geometry"/></mxCell></object><object id="technical-n340" label="Identify incident or reported bug&lt;br&gt;Capture impact, severity and evidence"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#EAF3F9;strokeColor=#32749A;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="82" y="672" width="426" height="78" as="geometry"/></mxCell></object><object id="technical-n341" label="Assign technical incident owner&lt;br&gt;Set response / update expectations"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#EAF3F9;strokeColor=#32749A;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="82" y="802" width="426" height="78" as="geometry"/></mxCell></object><object id="technical-n346" label="RESOLVE &amp; RESTORE"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;fontStyle=1;fontSize=19;fillColor=#EAF3F9;strokeColor=#32749A;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="575" y="210" width="450" height="46" as="geometry"/></mxCell></object><object id="technical-n347" label="Receive linked operational blocker&lt;br&gt;or monitoring incident"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#EAF3F9;strokeColor=#32749A;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="587" y="282" width="426" height="78" as="geometry"/></mxCell></object><object id="technical-n348" label="Diagnose failure&lt;br&gt;Bug, deadlock, API or webhook delivery"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#EAF3F9;strokeColor=#32749A;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="587" y="412" width="426" height="78" as="geometry"/></mxCell></object><object id="technical-n349" label="Apply authorised technical fix&lt;br&gt;Track change and affected services"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#EAF3F9;strokeColor=#32749A;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="587" y="542" width="426" height="78" as="geometry"/></mxCell></object><object id="technical-n350" label="Verify restoration with affected user&lt;br&gt;Unresolved → retain / escalate incident"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#EAF3F9;strokeColor=#32749A;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="587" y="672" width="426" height="78" as="geometry"/></mxCell></object><object id="technical-n351" label="Record resolution; notify manager&lt;br&gt;Employee resumes linked task [05]"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#EAF3F9;strokeColor=#32749A;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="587" y="802" width="426" height="78" as="geometry"/></mxCell></object><object id="technical-n357" label="CHANGE &amp; GOVERNANCE"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;fontStyle=1;fontSize=19;fillColor=#EAF3F9;strokeColor=#32749A;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1080" y="210" width="450" height="46" as="geometry"/></mxCell></object><object id="technical-n358" label="Record release / deployment request&lt;br&gt;Version, owner and reason"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#EAF3F9;strokeColor=#32749A;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1092" y="282" width="426" height="78" as="geometry"/></mxCell></object><object id="technical-n359" label="Record configuration changes&lt;br&gt;Environment changes without secret values"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#EAF3F9;strokeColor=#32749A;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1092" y="412" width="426" height="78" as="geometry"/></mxCell></object><object id="technical-n360" label="Record schema migrations&lt;br&gt;Link incident or planned work"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#EAF3F9;strokeColor=#32749A;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1092" y="542" width="426" height="78" as="geometry"/></mxCell></object><object id="technical-n361" label="Monitor after change&lt;br&gt;Record outcome and recovery if needed"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#EAF3F9;strokeColor=#32749A;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1092" y="672" width="426" height="78" as="geometry"/></mxCell></object><object id="technical-n362" label="Retain technical audit trail&lt;br&gt;Apply shared governance controls [04]"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#EAF3F9;strokeColor=#32749A;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1092" y="802" width="426" height="78" as="geometry"/></mxCell></object><object id="technical-n367" label="Platform parity&lt;br&gt;IT Analyst and Super Admin can manage master roles, departments, high-level accounts and full audit access. Their default dashboards emphasise different responsibilities."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="80" y="1030" width="710" height="125" as="geometry"/></mxCell></object><object id="technical-n368" label="Approval boundary&lt;br&gt;Commercial fee splits, leave and business deliverable approvals require a separately assigned business mandate. Technical remediation does not close the related business task automatically."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="835" y="1030" width="690" height="125" as="geometry"/></mxCell></object><object id="technical-n369" label="Return to exception resolution [06]" link="data:page/id,exceptions"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FBEDED;strokeColor=#B35C65;fontColor=#1B2935;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="80" y="1200" width="440" height="60" as="geometry"/></mxCell></object><object id="technical-n370" label="Administrative controls [04]" link="data:page/id,admin"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#EAF3F9;strokeColor=#32749A;fontColo