ceptions-n272" target="exceptions-n273"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="exceptions-e278" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#B35C65;strokeWidth=1.4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="exceptions-n273" target="exceptions-n274"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="exceptions-e279" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#2D7B5C;strokeWidth=1.4;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="exceptions-n272" target="exceptions-n274"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="exceptions-e281" value="Escalate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#B35C65;strokeWidth=1.4;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="exceptions-n251" target="exceptions-n280"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="exceptions-e282" value="Track escalation" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#B35C65;strokeWidth=1.4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="exceptions-n273" target="exceptions-n280"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="exceptions-e284" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#6B7B8D;strokeWidth=1.4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="exceptions-n280" target="exceptions-n283"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="exceptions-e285" value="No / review due" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#B35C65;strokeWidth=1.4;exitX=1;exitY=0.5;entryX=1;entryY=0.5;sourceJettySize=380;targetJettySize=50;" edge="1" parent="1" source="exceptions-n283" target="exceptions-n280"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="exceptions-e287" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#6B7B8D;strokeWidth=1.4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="exceptions-n283" target="exceptions-n286"><mxGeometry relative="1" as="geometry"/></mxCell><object id="exceptions-n245" label="06 • Keep work moving: overdue, reassignment &amp; blockers"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;fontStyle=1;fontSize=19;fillColor=#19344A;strokeColor=#19344A;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1520" height="55" as="geometry"/></mxCell></object><object id="exceptions-n246" label="LAYER 2 • Every exception retains a task owner, a decision owner and a next review date. No task disappears when its deadline passes."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=0;strokeOpacity=0;align=left;fillColor=#F5F7FA;strokeColor=#6B7B8D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1520" height="45" as="geometry"/></mxCell></object><object id="exceptions-n247" label="← OVERVIEW" link="data:page/id,overview"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1350" y="145" width="210" height="36" as="geometry"/></mxCell></object><object id="exceptions-n248" label="OVERDUE / DEADLINE RISK"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;fontStyle=1;fontSize=19;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="65" y="205" width="455" height="46" as="geometry"/></mxCell></object><object id="exceptions-n249" label="Deadline reached while unfinished&lt;br&gt;Record overdue age, priority and owner"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="77" y="277" width="431" height="78" as="geometry"/></mxCell></object><object id="exceptions-n250" label="Notify responsible manager&lt;br&gt;Include review / external waiting context"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="77" y="412" width="431" height="78" as="geometry"/></mxCell></object><object id="exceptions-n251" label="Manager reviews evidence&lt;br&gt;Select authorised intervention"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="77" y="547" width="431" height="78" as="geometry"/></mxCell></object><object id="exceptions-n252" label="Extend: save reason + new due date&lt;br&gt;Retain original due date and overdue history"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="77" y="682" width="431" height="78" as="geometry"/></mxCell></object><object id="exceptions-n253" label="Notify affected people&lt;br&gt;Continue work and monitor resolution"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="77" y="817" width="431" height="78" as="geometry"/></mxCell></object><object id="exceptions-n258" label="CONTROLLED REASSIGNMENT"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;fontStyle=1;fontSize=19;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="575" y="205" width="455" height="46" as="geometry"/></mxCell></object><object id="exceptions-n259" label="Reassignment requested&lt;br&gt;Keep the existing task ID"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="587" y="277" width="431" height="78" as="geometry"/></mxCell></object><object id="exceptions-n260" label="Check capacity, availability &amp; skills&lt;br&gt;Choose a new responsible employee"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="587" y="412" width="431" height="78" as="geometry"/></mxCell></object><object id="exceptions-n261" label="Record transfer reason&lt;br&gt;Handover completed work + remaining work"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="587" y="547" width="431" height="78" as="geometry"/></mxCell></object><object id="exceptions-n262" label="Update owner; preserve previous owner&lt;br&gt;Notify new owner and affected parties"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="587" y="682" width="431" height="78" as="geometry"/></mxCell></object><object id="exceptions-n263" label="Continue task in current workflow&lt;br&gt;Retain reassignment event history"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="587" y="817" width="431" height="78" as="geometry"/></mxCell></object><object id="exceptions-n269" label="ISSUE / BLOCKER"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;fontStyle=1;fontSize=19;fillColor=#FBEDED;strokeColor=#B35C65;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1085" y="205" width="455" height="46" as="geometry"/></mxCell></object><object id="exceptions-n270" label="Employee raises linked issue&lt;br&gt;Record severity, evidence and impact"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FBEDED;strokeColor=#B35C65;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1097" y="277" width="431" height="78" as="geometry"/></mxCell></object><object id="exceptions-n271" label="Manager assesses responsible resolver&lt;br&gt;Technical issue → IT [08]"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FBEDED;strokeColor=#B35C65;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1097" y="412" width="431" height="78" as="geometry"/></mxCell></object><object id="exceptions-n272" label="Resolved by manager?"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rhombus;fillColor=#FBEDED;strokeColor=#B35C65;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1097" y="547" width="431" height="78" as="geometry"/></mxCell></object><object id="exceptions-n273" label="If unresolved: escalate to configured&lt;br&gt;Senior / General Manager or specialist"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FBEDED;strokeColor=#B35C65;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1097" y="682" width="431" height="78" as="geometry"/></mxCell></object><object id="exceptions-n274" label="Keep follow-up owner &amp; review date&lt;br&gt;Verify resolution, then resume work"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FBEDED;strokeColor=#B35C65;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1097" y="817" width="431" height="78" as="geometry"/></mxCell></object><object id="exceptions-n280" label="ESCALATION &amp; FOLLOW-UP&lt;br&gt;Manager records impact, action required, receiving authority and next review date. High-impact business matters reach executive attention; technical faults reach IT."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FBEDED;strokeColor=#B35C65;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="180" y="1050" width="1230" height="105" as="geometry"/></mxCell></object><object id="exceptions-n283" label="Resolution confirmed?"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rhombus;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="520" y="1210" width="560" height="95" as="geometry"/></mxCell></object><object id="exceptions-n286" label="Resume execution / review [05]" link="data:page/id,tasks"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#E8F5EF;strokeColor=#2D7B5C;fontColor=#1B2935;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="590" y="1370" width="420" height="60" as="geometry"/></mxCell></object><object id="exceptions-n288" label="Reassignment, approved extensions and issue resolution all append history. Escalation paths follow configured responsibility and authority; role names alone do not establish a reporting hierarchy."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=0;strokeOpacity=0;align=left;fillColor=#F5F7FA;strokeColor=#6B7B8D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="40" y="1430" width="1520" height="55" as="geometry"/></mxCell></object></root></mxGraphModel></diagram><diagram id="people" name="07 • Attendance, availability &amp; employee services"><mxGraphModel dx="1600" dy="1560" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1560" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="people-e299" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#2D7B5C;strokeWidth=1.4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="people-n293" target="people-n294"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="people-e300" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#2D7B5C;strokeWidth=1.4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="people-n294" target="people-n295"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="peo