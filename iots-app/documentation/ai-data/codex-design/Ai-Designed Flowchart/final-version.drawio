e="1" parent="1" source="tasks-n233" target="tasks-n223"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tasks-e237" value="Blocked" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#B35C65;strokeWidth=1.4;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="tasks-n219" target="tasks-n236"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tasks-e239" value="At risk / overdue" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#B35C65;strokeWidth=1.4;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="tasks-n221" target="tasks-n238"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tasks-e243" value="Approved outcome" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#70529D;strokeWidth=1.4;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="tasks-n229" target="tasks-n242"><mxGeometry relative="1" as="geometry"/></mxCell><object id="tasks-n204" label="05 • Shared work lifecycle: plan → deliver → review → close"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;fontStyle=1;fontSize=19;fillColor=#19344A;strokeColor=#19344A;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1520" height="55" as="geometry"/></mxCell></object><object id="tasks-n205" label="LAYER 2 • Applies to all operational work: member coordination, outreach, events, creative assets, IT incidents and internal assignments."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=0;strokeOpacity=0;align=left;fillColor=#F5F7FA;strokeColor=#6B7B8D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1520" height="45" as="geometry"/></mxCell></object><object id="tasks-n206" label="← OVERVIEW" link="data:page/id,overview"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1350" y="145" width="210" height="36" as="geometry"/></mxCell></object><object id="tasks-n207" label="MANAGER • allocation &amp; review"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;fontStyle=1;fontSize=19;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="50" y="190" width="465" height="45" as="geometry"/></mxCell></object><object id="tasks-n208" label="EXECUTION • assigned employee"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;fontStyle=1;fontSize=19;fillColor=#E8F5EF;strokeColor=#2D7B5C;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="565" y="190" width="465" height="45" as="geometry"/></mxCell></object><object id="tasks-n209" label="CONTROLS • exceptions &amp; history"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;fontStyle=1;fontSize=19;fillColor=#EAF3F9;strokeColor=#32749A;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1080" y="190" width="465" height="45" as="geometry"/></mxCell></object><object id="tasks-n210" label="Create task&lt;br&gt;Purpose, deliverables &amp; acceptance criteria"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="90" y="270" width="385" height="80" as="geometry"/></mxCell></object><object id="tasks-n211" label="Set priority &amp; due date&lt;br&gt;Link member / event / CRM record if relevant"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="90" y="400" width="385" height="80" as="geometry"/></mxCell></object><object id="tasks-n212" label="Check workload, skills &amp; availability&lt;br&gt;Choose employee and designated reviewer"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="90" y="530" width="385" height="80" as="geometry"/></mxCell></object><object id="tasks-n213" label="Assign task → notify employee&lt;br&gt;Status: Assigned / Pending"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="90" y="660" width="385" height="80" as="geometry"/></mxCell></object><object id="tasks-n217" label="View own task queue &amp; details&lt;br&gt;Confirm deliverables and deadline"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#E8F5EF;strokeColor=#2D7B5C;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="605" y="660" width="385" height="80" as="geometry"/></mxCell></object><object id="tasks-n219" label="Start / continue work&lt;br&gt;Status: In Progress"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#E8F5EF;strokeColor=#2D7B5C;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="605" y="790" width="385" height="80" as="geometry"/></mxCell></object><object id="tasks-n221" label="Log progress, notes and effort&lt;br&gt;Attach versioned evidence"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#E8F5EF;strokeColor=#2D7B5C;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="605" y="920" width="385" height="80" as="geometry"/></mxCell></object><object id="tasks-n223" label="Submit deliverables&lt;br&gt;Status: Waiting for Review"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#E8F5EF;strokeColor=#2D7B5C;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="605" y="1050" width="385" height="80" as="geometry"/></mxCell></object><object id="tasks-n225" label="Review against deliverables&lt;br&gt;Status: Under Review"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="90" y="1050" width="385" height="80" as="geometry"/></mxCell></object><object id="tasks-n227" label="Approved?"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rhombus;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="145" y="1190" width="270" height="95" as="geometry"/></mxCell></object><object id="tasks-n229" label="Complete &amp; close&lt;br&gt;Store approval and final evidence"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#E8F5EF;strokeColor=#2D7B5C;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="90" y="1390" width="385" height="80" as="geometry"/></mxCell></object><object id="tasks-n231" label="Return with specific corrections&lt;br&gt;Status: Changes Requested&lt;br&gt;Notify employee"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FBEDED;strokeColor=#B35C65;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="605" y="1190" width="385" height="95" as="geometry"/></mxCell></object><object id="tasks-n233" label="Revise • preserve earlier versions&lt;br&gt;Resubmit for manager review"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#E8F5EF;strokeColor=#2D7B5C;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="605" y="1390" width="385" height="80" as="geometry"/></mxCell></object><object id="tasks-n236" label="Issue / blocker → resolution [06]" link="data:page/id,exceptions"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FBEDED;strokeColor=#B35C65;fontColor=#1B2935;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1120" y="790" width="385" height="60" as="geometry"/></mxCell></object><object id="tasks-n238" label="Deadline / reassignment intervention [06]" link="data:page/id,exceptions"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FBEDED;strokeColor=#B35C65;fontColor=#1B2935;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1120" y="920" width="385" height="60" as="geometry"/></mxCell></object><object id="tasks-n240" label="Activity entries are historical records.&lt;br&gt;Progress %, notes, files and time entries do not create extra task states."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#EAF3F9;strokeColor=#32749A;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1120" y="1050" width="385" height="95" as="geometry"/></mxCell></object><object id="tasks-n241" label="One task ID throughout&lt;br&gt;Retain assignment, deadline, submission, review and cancellation history."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#EAF3F9;strokeColor=#32749A;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1120" y="1200" width="385" height="95" as="geometry"/></mxCell></object><object id="tasks-n242" label="Operational records → analytics [12]" link="data:page/id,analytics"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1120" y="1390" width="385" height="60" as="geometry"/></mxCell></object><object id="tasks-n244" label="Cancellation is a separately authorised outcome with a recorded reason; it is never counted as completed work. Review delay remains visible. Reassignment is an event, and overdue is an exception overlay on an unfinished task."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=0;strokeOpacity=0;align=left;fillColor=#F5F7FA;strokeColor=#6B7B8D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="40" y="1540" width="1520" height="65" as="geometry"/></mxCell></object></root></mxGraphModel></diagram><diagram id="exceptions" name="06 • Keep work moving: overdue, reassignment &amp; blockers"><mxGraphModel dx="1600" dy="1500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1500" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="exceptions-e254" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#C66B17;strokeWidth=1.4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="exceptions-n249" target="exceptions-n250"><mxGeometry relative="1" as="geometry"/>