l;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#70529D;strokeWidth=1.4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="chairman-n600" target="chairman-n601"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="chairman-e607" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#70529D;strokeWidth=1.4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="chairman-n601" target="chairman-n602"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="chairman-e608" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#70529D;strokeWidth=1.4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="chairman-n602" target="chairman-n603"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="chairman-e609" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#70529D;strokeWidth=1.4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="chairman-n603" target="chairman-n604"><mxGeometry relative="1" as="geometry"/></mxCell><object id="chairman-n570" label="13 • Chairman oversight, appraisal &amp; recognition"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;fontStyle=1;fontSize=19;fillColor=#19344A;strokeColor=#19344A;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1520" height="55" as="geometry"/></mxCell></object><object id="chairman-n571" label="LAYER 3 → AUTHORISED ACTION • Vijay Sir sees the overall operational picture and can inspect underlying evidence."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=0;strokeOpacity=0;align=left;fillColor=#F5F7FA;strokeColor=#6B7B8D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1520" height="45" as="geometry"/></mxCell></object><object id="chairman-n572" label="← OVERVIEW" link="data:page/id,overview"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1350" y="145" width="210" height="36" as="geometry"/></mxCell></object><object id="chairman-n573" label="EXECUTIVE OPERATIONAL VIEW"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;fontStyle=1;fontSize=19;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="65" y="205" width="450" height="46" as="geometry"/></mxCell></object><object id="chairman-n574" label="Review enterprise operational health&lt;br&gt;Teams, delivery trends and major risks"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="77" y="277" width="426" height="78" as="geometry"/></mxCell></object><object id="chairman-n575" label="Inspect commercial deal flow&lt;br&gt;Royalty due, collected and outstanding"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="77" y="412" width="426" height="78" as="geometry"/></mxCell></object><object id="chairman-n576" label="Review attendance / location summaries&lt;br&gt;Remote and unknown trends with context"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="77" y="547" width="426" height="78" as="geometry"/></mxCell></object><object id="chairman-n577" label="Open Requires Attention&lt;br&gt;Overdue clusters, reassignments, blockers"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="77" y="682" width="426" height="78" as="geometry"/></mxCell></object><object id="chairman-n578" label="Inspect evidence and responsible owner&lt;br&gt;Direct follow-up to authorised manager"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="77" y="817" width="426" height="78" as="geometry"/></mxCell></object><object id="chairman-n579" label="Review outcome on next reporting cycle&lt;br&gt;Unresolved items remain visible"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="77" y="952" width="426" height="78" as="geometry"/></mxCell></object><object id="chairman-n585" label="MONTHLY → QUARTERLY RECOGNITION"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;fontStyle=1;fontSize=19;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="575" y="205" width="450" height="46" as="geometry"/></mxCell></object><object id="chairman-n586" label="Apply approved role-specific KPIs&lt;br&gt;Use quality, delivery and verified records"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="587" y="277" width="426" height="78" as="geometry"/></mxCell></object><object id="chairman-n587" label="Generate monthly performance standing&lt;br&gt;Show rule version and evidence"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="587" y="412" width="426" height="78" as="geometry"/></mxCell></object><object id="chairman-n588" label="Manager validates exceptions / context&lt;br&gt;Employee can request score review"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="587" y="547" width="426" height="78" as="geometry"/></mxCell></object><object id="chairman-n589" label="Three consecutive qualifying months?"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rhombus;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="587" y="682" width="426" height="78" as="geometry"/></mxCell></object><object id="chairman-n590" label="Yes: build quarterly excellence dossier&lt;br&gt;Include three-month history and evidence"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="587" y="817" width="426" height="78" as="geometry"/></mxCell></object><object id="chairman-n591" label="Chairman reviews and signs off&lt;br&gt;Record decision and recognition outcome"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="587" y="952" width="426" height="78" as="geometry"/></mxCell></object><object id="chairman-n598" label="REPORTS &amp; ANNOUNCEMENTS"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;fontStyle=1;fontSize=19;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1085" y="205" width="450" height="46" as="geometry"/></mxCell></object><object id="chairman-n599" label="Choose period, scope and report type&lt;br&gt;Enterprise / team / individual appraisal"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1097" y="277" width="426" height="78" as="geometry"/></mxCell></object><object id="chairman-n600" label="Generate configured appraisal format&lt;br&gt;Export approved report with audit entry"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1097" y="412" width="426" height="78" as="geometry"/></mxCell></object><object id="chairman-n601" label="Create Chairman announcement&lt;br&gt;Select enterprise audience and schedule"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1097" y="547" width="426" height="78" as="geometry"/></mxCell></object><object id="chairman-n602" label="Publish official communication&lt;br&gt;Display in authorised employee workspaces"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1097" y="682" width="426" height="78" as="geometry"/></mxCell></object><object id="chairman-n603" label="Record publication and decision history&lt;br&gt;Keep supporting documents accessible"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1097" y="817" width="426" height="78" as="geometry"/></mxCell></object><object id="chairman-n604" label="Review acknowledgement where configured&lt;br&gt;Follow up through responsible management"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1097" y="952" width="426" height="78" as="geometry"/></mxCell></object><object id="chairman-n610" label="Authority boundary&lt;br&gt;Chairman reviews intelligence, strategic attention and recognition. Routine task reassignment and employee password resets remain with authorised managers and administrators."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="70" y="1190" width="710" height="130" as="geometry"/></mxCell></object><object id="chairman-n611" label="Recognition policy to approve&lt;br&gt;Supporting document proposes 100-point scoring and Gold ≥90. Treat scoring weights, thresholds, incentives and qualifying periods as configurable policy pending CIRIL approval. Three consecutive qualifying months and Chairman sign-off are required."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="830" y="1190" width="700" height="130" as="geometry"/></mxCell></object><object id="chairman-n612" label="Fair interpretation: approved leave, remote work, external blockers and review delays retain their context. Recorded hours alone do not prove output quality. Display the evidence behind each standing and keep score-review decisions."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=0;strokeOpacity=0;align=left;fillColor=#F5F7FA;strokeColor=#6B7B8D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="40" y="1380" width="1520" height="70" as="geometry"/></mxCell></object><object id="chairman-n613" label="Management action [09]" link="data:page/id,managers"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="80" y="1470" width="430" height="60" as="geometry"/></mxCell></object><object id="chairman-n614" label="Reporting and metric rules [12]" link="data:page/id,analytics"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1080" y="1470" width="450" height="60" as="geometry"/></mxCell></object></root></mxGraphModel></diagram><diagram id="basis" name="14 • Source basis, refinements &amp; implementation decisions"><mxGraphModel dx="1600" dy="1510" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1510" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><object id="basis-n615" label="14 • Source basis, refinements &amp; implementation decisions"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;fontStyle=1;fontSize=19;fillColor=#19344A;strokeColor=#19344A;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1520" height="55" as="geometry"/></mxCell></object><object id="basis-n616" label="Reading guide • 01 overview; 02–03 entry and roles; 04–11 operations; 12–13 intelligence. This file is an operational design, not a claim that these IOTS features are implemented."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=0;strokeOpacity=0;align=left;fillColor=#F5F7FA;strokeColor=#6B7B8D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1520" height="45" as="geometry"/></mxCell></object><object id="basis-n617" label="← OVERVIEW" link="data:page/id,overview"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1350" y="145" width="210" height="36" as="geometry"/></mxCell></object><object id="basis-n618" label="AUTHORITATIVE REQUIREMENTS&lt;br&gt;&lt;br&gt;gpt_prompt.txt&lt;br&gt;Ten roles and supplied responsibilities; multi-role context; three layers; Chairman visibility; equal SA / IT platform privilege; business approval boundaries."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F5F7FA;strokeColor=#6B7B8D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="60" y="210" width="740" height="180" as="geometry"/></mxCell></object><object id="basis-n619" label="BUSINESS FOUNDATION&lt;br&gt;&lt;br&gt;ciril_crm_detail.pdf, 20 pages&lt;br&gt;Member network, lead giver / receiver, variable brokerage shares, lease-day calculation, 7.5% royalty, negotiation, proposals, payment and research context."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F5F7FA;strokeColor=#6B7B8D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="840" y="210" width="740" height="180" as="geometry"/></mxCell></object><object id="basis-n620" label="PRESERVED DESIGN&lt;br&gt;&lt;br&gt;../Flowchart/Actual-FlowChart.drawio&lt;br&gt;Login / location / audit sequence; three architectural lanes; six Admin branches; eight Manager branches. Complete employee and analytics flows from Construct.txt."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F5F7FA;strokeColor=#6B7B8D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="60" y="425" width="740" height="180" as="geometry"/></mxCell></object><object id="basis-n621" label="SUPPORTING MATERIAL&lt;br&gt;&lt;br&gt;claude_version.docx&lt;br&gt;Task revision, audit principles, attendance, reporting and recognition concepts. Explicit prompt roles override section 2.2. Fixed share, scoring and shift examples are not binding company policy."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F5F7FA;strokeColor=#6B7B8D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="840" y="425" width="740" height="180" as="geometry"/></mxCell></object><object id="basis-n622" label="VISUAL FOUNDATION&lt;br&gt;&lt;br&gt;referential-flowchart.jpeg&lt;br&gt;Dark start/end; blue administrative controls; orange management; green execution; purple reporting; rounded process boxes, decision diamonds and orthogonal connectors."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F5F7FA;strokeColor=#6B7B8D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="60" y="640" width="740" height="180" as="geometry"/></mxCell></object><object id="basis-n623" label="CRM CROSS-CHECK&lt;br&gt;&lt;br&gt;Local code found at CRM/Updated/public_html/public_html&lt;br&gt;Reviewed routes, lead / assignment / brokerage / royalty controllers, key models and SQL schema. The requested CRM/Update/public_html location is absent."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F5F7FA;strokeColor=#6B7B8D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="840" y="640" width="740" height="180" as="geometry"/></mxCell></object><object id="basis-n624" label="REFINEMENTS THAT COMPLETE THE FOUNDATION"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;fontStyle=1;fontSize=19;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="40" y="890" width="1520" height="40" as="geometry"/></mxCell></object><object id="basis-n625" label="Entry and permissions&lt;br&gt;Preserve the original login flow; add active-account / no-role cases, unknown location, primary role and context switch. Enforce active-role scope on actions and reporting."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#EAF3F9;strokeColor=#32749A;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="65" y="955" width="475" height="160" as="geometry"/></mxCell></object><object id="basis-n626" label="Work and accountability&lt;br&gt;Complete submission / correction / approval loops; explicit owner and escalation follow-up; separate task state from activity; overdue is a flag; reassignment keeps one task identity."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="562" y="955" width="475" height="160" as="geometry"/></mxCell></object><object id="basis-n627" label="Records and insight&lt;br&gt;Separate checkout from session end; preserve corrections and history; role-scoped reporting; rules explain risks; Chairman appraisal and three-month recognition review."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1060" y="955" width="475" height="160" as="geometry"/></mxCell></object><object id="basis-n628" label="OPEN DESIGN CHOICES • configurable, with no invented company policy"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;fontStyle=1;fontSize=19;fillColor=#19344A;strokeColor=#19344A;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="1165" width="1520" height="40" as="geometry"/></mxCell></object><object id="basis-n629" label="Confirm approval and escalation matrix; working hours, grace periods and break rules; report schedules; appraisal template; recognition scoring; retention rules; designated financial authority; CRM linking / import mechanism."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=0;strokeOpacity=0;align=left;fillColor=#F5F7FA;strokeColor=#6B7B8D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="40" y="1230" width="1520" height="80" as="geometry"/></mxCell></object><object id="basis-n630" label="CRM caution: current users.roleId is a single role field; IOTS multi-role assignment is a new requirement. CRM royalityStatus updates lead_status to 8 but inserts status_id 7 into lead_statuses. Mapping needs reconciliation before integration."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=0;strokeOpacity=0;align=left;fillColor=#F5F7FA;strokeColor=#6B7B8D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="40" y="1320" width="1520" height="75" as="geometry"/></mxCell></object><object id="basis-n631" label="Historical chat_gpt_chats.pdf was not needed. Draw.io MCP is unavailable in this session; this artifact uses native editable Draw.io XML. Sources are local; no source document or CRM application was modified."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=0;strokeOpacity=0;align=left;fillColor=#F5F7FA;strokeColor=#6B7B8D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="40" y="1405" width="1520" height="70" as="geometry"/></mxCell></object></root></mxGraphModel></diagram></mxfile>