ntryX=0.5;entryY=0;" edge="1" parent="1" source="access-n66" target="access-n70"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="access-e75" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#6B7B8D;strokeWidth=1.4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="access-n70" target="access-n74"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="access-e77" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#6B7B8D;strokeWidth=1.4;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="access-n74" target="access-n76"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="access-e79" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#6B7B8D;strokeWidth=1.4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="access-n74" target="access-n78"><mxGeometry relative="1" as="geometry"/></mxCell><object id="access-n47" label="02 • Secure entry &amp; workspace selection"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;fontStyle=1;fontSize=19;fillColor=#19344A;strokeColor=#19344A;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1520" height="55" as="geometry"/></mxCell></object><object id="access-n48" label="LAYER 1 • Retains the foundation: login → credentials → location → audit → role routing. Small additions cover account status, missing location and multiple roles."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=0;strokeOpacity=0;align=left;fillColor=#F5F7FA;strokeColor=#6B7B8D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1520" height="45" as="geometry"/></mxCell></object><object id="access-n49" label="← OVERVIEW" link="data:page/id,overview"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1350" y="145" width="210" height="36" as="geometry"/></mxCell></object><object id="access-n50" label="Enter corporate credentials&lt;br&gt;No public registration"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#EAF3F9;strokeColor=#32749A;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="650" y="175" width="300" height="70" as="geometry"/></mxCell></object><object id="access-n51" label="Credentials valid?"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rhombus;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="650" y="280" width="300" height="100" as="geometry"/></mxCell></object><object id="access-n53" label="Show invalid login message&lt;br&gt;Offer authorised password recovery"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FBEDED;strokeColor=#B35C65;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="160" y="292" width="330" height="78" as="geometry"/></mxCell></object><object id="access-n56" label="Account active?"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rhombus;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="650" y="430" width="300" height="100" as="geometry"/></mxCell></object><object id="access-n58" label="Access unavailable&lt;br&gt;Contact authorised administrator"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FBEDED;strokeColor=#B35C65;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1120" y="442" width="350" height="78" as="geometry"/></mxCell></object><object id="access-n60" label="Request location&lt;br&gt;Compare coordinates with office boundary"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#EAF3F9;strokeColor=#32749A;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="650" y="580" width="300" height="80" as="geometry"/></mxCell></object><object id="access-n62" label="Location result?"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rhombus;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="650" y="710" width="300" height="100" as="geometry"/></mxCell></object><object id="access-n64" label="Inside approved boundary&lt;br&gt;Office / on-site context"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#E8F5EF;strokeColor=#2D7B5C;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="120" y="870" width="340" height="78" as="geometry"/></mxCell></object><object id="access-n65" label="Outside approved boundary&lt;br&gt;Remote / off-site context + optional reason"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="630" y="870" width="340" height="78" as="geometry"/></mxCell></object><object id="access-n66" label="Denied / unavailable / inaccurate&lt;br&gt;Unknown location + reason for review"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FBEDED;strokeColor=#B35C65;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1140" y="870" width="340" height="78" as="geometry"/></mxCell></object><object id="access-n70" label="Record login time &amp; location result&lt;br&gt;Known coordinates where available; keep exceptions"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#EAF3F9;strokeColor=#32749A;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="550" y="1005" width="500" height="78" as="geometry"/></mxCell></object><object id="access-n74" label="Any authorised role?"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rhombus;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="650" y="1125" width="300" height="100" as="geometry"/></mxCell></object><object id="access-n76" label="No workspace access&lt;br&gt;Ask Admin to resolve role assignment"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FBEDED;strokeColor=#B35C65;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="150" y="1137" width="340" height="78" as="geometry"/></mxCell></object><object id="access-n78" label="Open primary role workspace [03]" link="data:page/id,roles"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="640" y="1290" width="320" height="60" as="geometry"/></mxCell></object><object id="access-n80" label="Location exceptions continue to the permitted workspace and remain available for attendance review. A remote label does not itself approve remote work or prove absence."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=0;strokeOpacity=0;align=left;fillColor=#F5F7FA;strokeColor=#6B7B8D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="40" y="1390" width="1520" height="55" as="geometry"/></mxCell></object><object id="access-n81" label="Recommended refinements: credential recovery uses authorised identity checks; permissions are checked on every action; expiry/logout ends the session. Attendance checkout is handled separately [07]."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=0;strokeOpacity=0;align=left;fillColor=#F5F7FA;strokeColor=#6B7B8D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="40" y="1450" width="1520" height="55" as="geometry"/></mxCell></object></root></mxGraphModel></diagram><diagram id="roles" name="03 • One identity, ten roles, three functional lanes"><mxGraphModel dx="1600" dy="1510" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1510" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="roles-e89" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#6B7B8D;strokeWidth=1.4;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="roles-n85" target="roles-n86"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="roles-e90" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#6B7B8D;strokeWidth=1.4;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="roles-n86" target="roles-n87"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="roles-e91" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#6B7B8D;strokeWidth=1.4;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="roles-n87" target="roles-n88"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="roles-e93" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#6B7B8D;strokeWidth=1.4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="roles-n88" target="roles-n92"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="roles-e94" value="Switch applied" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#70529D;strokeWidth=1.4;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="roles-n92" target="roles-n87"><mxGeometry relative="1" as="geometry"/></mxCell><object id="roles-n82" label="03 • One identity, ten roles, three functional lanes"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;fontStyle=1;fontSize=19;fillColor=#19344A;strokeColor=#19344A;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1520" height="55" as="geometry"/></mxCell></object><object id="roles-n83" label="LAYER 1 → LAYER 2 • Roles, designations and reporting relationships are configurable. A person may hold several roles; every action uses the active role and permitted data scope."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=0;strokeOpacity=0;align=left;fillColor=#F5F7FA;strokeColor=#6B7B8D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1520" height="45" as="geometry"/></mxCell></object><object id="roles-n84" label="← OVERVIEW" link="data:page/id,overview"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1350" y="145" width="210" height="36" as="geometry"/></mxCell></object><object id="roles-n85" label="Single employee identity"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#19344A;strokeColor=#19344A;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="60" y="185" width="270" height="65" as="geometry"/></mxCell></object><object id="roles-n86" label="Assigned roles + primary role&lt;br&gt;Office / department / reporting manager"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#EAF3F9;strokeColor=#32749A;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="400" y="185" width="360" height="65" as="geometry"/></mxCell></object><object id="roles-n87" label="Primary workspace&lt;br&gt;Only permitted sections appear"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="830" y="185" width="300" height="65" as="geometry"/></mxCell></object><object id="roles-n88" label="Choose another&lt;br&gt;authorised workspace"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1200" y="185" width="330" height="65" as="geometry"/></mxCell></object><object id="roles-n92" label="Recheck selected role &amp; scope&lt;br&gt;Refresh workspace permissions&lt;br&gt;Audit identity + active role"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1200" y="300" width="330" height="85" as="geometry"/></mxCell></object><object id="roles-n95" label="FUNCTIONAL ARCHITECTURE • The lane is a category; the role determines authority"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;fontStyle=1;fontSize=19;fillColor=#19344A;strokeColor=#19344A;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="1520" height="40" as="geometry"/></mxCell></object><object id="roles-n96" label="ADMINISTRATIVE"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;fontStyle=1;fontSize=19;fillColor=#EAF3F9;strokeColor=#32749A;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="70" y="510" width="450" height="46" as="geometry"/></mxCell></object><object id="roles-n97" label="ADMIN&lt;br&gt;Internal profiles, geofences, attendance exceptions, global oversight &amp; notices [04]"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#EAF3F9;strokeColor=#32749A;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="82" y="582" width="426" height="78" as="geometry"/></mxCell></object><object id="roles-n98" label="SUPER ADMIN&lt;br&gt;Master organisation, roles, permissions, high-level accounts, audit &amp; export policy [04]"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#EAF3F9;strokeColor=#32749A;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="82" y="722" width="426" height="78" as="geometry"/></mxCell></object><object id="roles-n99" label="IT SYSTEM ANALYST&lt;br&gt;Equal platform privileges to Super Admin; technical health, incidents &amp; deployments [08]"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#EAF3F9;strokeColor=#32749A;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="82" y="862" width="426" height="78" as="geometry"/></mxCell></object><object id="roles-n100" label="Business approval requires an explicit business mandate, even with full platform privileges."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#EAF3F9;strokeColor=#32749A;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="82" y="1002" width="426" height="78" as="geometry"/></mxCell></object><object id="roles-n104" label="MANAGEMENT"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;fontStyle=1;fontSize=19;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="575" y="510" width="450" height="46" as="geometry"/></mxCell></object><object id="roles-n105" label="GENERAL MANAGER&lt;br&gt;Operations, Board, finance, legal, audits, events, membership &amp; office coordination [09]"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="587" y="582" width="426" height="78" as="geometry"/></mxCell></object><object id="roles-n106" label="SENIOR MANAGER&lt;br&gt;Cross-team capacity, deadline risk, escalated decisions &amp; comparative performance [09]"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="587" y="722" width="426" height="78" as="geometry"/></mxCell></object><object id="roles-n107" label="LEAD MANAGER • Manasa&lt;br&gt;Operational team delivery; member deals, royalty follow-up, calls &amp; reports [09–11]"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="587" y="862" width="426" height="78" as="geometry"/></mxCell></object><object id="roles-n108" label="CHAIRMAN • Vijay Sir&lt;br&gt;Executive oversight, attention items, all reports, announcements &amp; award sign-off [13]"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="587" y="1002" width="426" height="78" as="geometry"/></mxCell></object><object id="roles-n112" label="EXECUTION"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;fontStyle=1;fontSize=19;fillColor=#E8F5EF;strokeColor=#2D7B5C;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1080" y="510" width="450" height="46" as="geometry"/></mxCell></object><object id="roles-n113" label="EXECUTIVE&lt;br&gt;Assigned operational work, activity, evidence, blockers, revisions &amp; personal services [05, 07]"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#E8F5EF;strokeColor=#2D7B5C;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1092" y="582" width="426" height="78" as="geometry"/></mxCell></object><object id="roles-n114" label="BUSINESS DEVELOPMENT EXECUTIVE&lt;br&gt;Broker research, outreach, portals, campaigns, follow-ups &amp; meeting records [10]"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#E8F5EF;strokeColor=#2D7B5C;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1092" y="722" width="426" height="78" as="geometry"/></mxCell></object><object id="roles-n115" label="CREATIVES COMMUNICATION ASSOCIATE&lt;br&gt;Social media + design; content, proofreading, Office calls &amp; conference assets [11]"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#E8F5EF;strokeColor=#2D7B5C;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1092" y="862" width="426" height="78" as="geometry"/></mxCell></object><object id="roles-n116" label="Shared personal workspace: attendance, availability, requests, feedback, profile &amp; security [07]"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#E8F5EF;strokeColor=#2D7B5C;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1092" y="1002" width="426" height="78" as="geometry"/></mxCell></object><object id="roles-n120" label="PERMISSION RULES"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;fontStyle=1;fontSize=19;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="40" y="1200" width="1520" height="40" as="geometry"/></mxCell></object><object id="roles-n121" label="Chairman: broad visibility and strategic review. Routine password resets and task reassignment stay with authorised administrators/managers."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="70" y="1270" width="450" height="100" as="geometry"/></mxCell></object><object id="roles-n122" label="Harshitha example: Creatives Associate + Executive. One account; switch context; work and audit remain attributable to the same person."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="575" y="1270" width="450" height="100" as="geometry"/></mxCell></object><object id="roles-n123" label="New roles or additional staff extend assigned capabilities. Roles do not fix headcount, automatically establish rank, or combine permissions across inactive workspaces."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1080" y="1270" width="450" height="100" as="geometry"/></mxCell></object><object id="roles-n124" label="Deployment context supplied by the requester: 1 Chairman; 3 BDEs; 2 IT Analysts; 1 Social Media Manager and 1 Graphic Designer; 1 GM / Assistant GM context. Creative functions share a role profile; people remain separate accounts."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=0;strokeOpacity=0;align=left;fillColor=#F5F7FA;strokeColor=#6B7B8D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="40" y="1410" width="1520" height="65" as="geometry"/></mxCell></object></root></mxGraphModel></diagram><diagram id="admin" name="04 • Administrative control &amp; governance"><mxGraphModel dx="1600" dy="1420" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1420" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="admin-e135" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#32749A;strokeWidth=1.4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="admin-n129" target="admin-n130"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="admin-e136" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Arial;fontSize=12;labelBackgroundColor=#