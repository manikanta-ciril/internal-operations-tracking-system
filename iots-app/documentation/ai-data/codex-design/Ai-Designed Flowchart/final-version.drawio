 value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#C66B17;strokeWidth=1.4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="managers-n393" target="managers-n394"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="managers-e401" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#C66B17;strokeWidth=1.4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="managers-n394" target="managers-n395"><mxGeometry relative="1" as="geometry"/></mxCell><object id="managers-n371" label="09 • Operational management &amp; CIRIL coordination"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;fontStyle=1;fontSize=19;fillColor=#19344A;strokeColor=#19344A;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1520" height="55" as="geometry"/></mxCell></object><object id="managers-n372" label="LAYER 2 • General / Lead Manager cards are independent work areas using lifecycle [05]. The centre column shows the Senior Manager review cycle."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=0;strokeOpacity=0;align=left;fillColor=#F5F7FA;strokeColor=#6B7B8D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1520" height="45" as="geometry"/></mxCell></object><object id="managers-n373" label="← OVERVIEW" link="data:page/id,overview"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1350" y="145" width="210" height="36" as="geometry"/></mxCell></object><object id="managers-n374" label="GENERAL MANAGER"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;fontStyle=1;fontSize=19;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="60" y="205" width="450" height="46" as="geometry"/></mxCell></object><object id="managers-n375" label="Receive organisational priorities&lt;br&gt;Coordinate daily operations and teams"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="72" y="277" width="426" height="78" as="geometry"/></mxCell></object><object id="managers-n376" label="Board: agendas, meeting preparation&lt;br&gt;Minutes, decisions and follow-up owners"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="72" y="407" width="426" height="78" as="geometry"/></mxCell></object><object id="managers-n377" label="Accounts: invoices, payments &amp; expenses&lt;br&gt;Legal: agreements, contracts and NDAs"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="72" y="537" width="426" height="78" as="geometry"/></mxCell></object><object id="managers-n378" label="Coordinate auditor and internal teams&lt;br&gt;Track compliance, filings &amp; evidence"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="72" y="667" width="426" height="78" as="geometry"/></mxCell></object><object id="managers-n379" label="Annual / zonal conferences&lt;br&gt;Hotels, vendors, members and speakers"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="72" y="797" width="426" height="78" as="geometry"/></mxCell></object><object id="managers-n380" label="Membership discussions &amp; virtual meetings&lt;br&gt;Coordinate member-office requirements"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="72" y="927" width="426" height="78" as="geometry"/></mxCell></object><object id="managers-n381" label="Review outcomes, outstanding actions&lt;br&gt;&amp; cross-functional escalations"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="72" y="1057" width="426" height="78" as="geometry"/></mxCell></object><object id="managers-n388" label="SENIOR MANAGER"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;fontStyle=1;fontSize=19;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="575" y="205" width="450" height="46" as="geometry"/></mxCell></object><object id="managers-n389" label="View cross-team work and capacity&lt;br&gt;Operations, BD and creative teams"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="587" y="277" width="426" height="78" as="geometry"/></mxCell></object><object id="managers-n390" label="Identify overload &amp; approaching deadlines&lt;br&gt;Compare availability and priorities"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="587" y="407" width="426" height="78" as="geometry"/></mxCell></object><object id="managers-n391" label="Agree workload changes with owners&lt;br&gt;Use controlled reassignment [06]"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="587" y="537" width="426" height="78" as="geometry"/></mxCell></object><object id="managers-n392" label="Review high-impact escalated decisions&lt;br&gt;Check evidence and approval authority"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="587" y="667" width="426" height="78" as="geometry"/></mxCell></object><object id="managers-n393" label="Compare team performance trends&lt;br&gt;Investigate recurring delays / blockers"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="587" y="797" width="426" height="78" as="geometry"/></mxCell></object><object id="managers-n394" label="Record decision, feedback or escalation&lt;br&gt;Notify responsible managers"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="587" y="927" width="426" height="78" as="geometry"/></mxCell></object><object id="managers-n395" label="Monitor improvement and resolution&lt;br&gt;Keep open actions visible"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="587" y="1057" width="426" height="78" as="geometry"/></mxCell></object><object id="managers-n402" label="LEAD / OPERATIONS MANAGER"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;fontStyle=1;fontSize=19;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1090" y="205" width="450" height="46" as="geometry"/></mxCell></object><object id="managers-n403" label="Manasa: coordinate members on deals&lt;br&gt;Conclusions and royalty follow-ups [10]"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1102" y="277" width="426" height="78" as="geometry"/></mxCell></object><object id="managers-n404" label="Retail / L&amp;W / Land / Hotel calls&lt;br&gt;Coordinate vertical and client calls"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1102" y="407" width="426" height="78" as="geometry"/></mxCell></object><object id="managers-n405" label="Office Space portal listings &amp; enquiries&lt;br&gt;Route to member offices; follow up"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1102" y="537" width="426" height="78" as="geometry"/></mxCell></object><object id="managers-n406" label="Collect market data; prepare quarterly&lt;br&gt;lead exchange and business statistics"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1102" y="667" width="426" height="78" as="geometry"/></mxCell></object><object id="managers-n407" label="Member performance ratings&lt;br&gt;Raw zonal conference presentations"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1102" y="797" width="426" height="78" as="geometry"/></mxCell></object><object id="managers-n408" label="Bitra website updates; printers&lt;br&gt;Stationery, reports &amp; annual event assets"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1102" y="927" width="426" height="78" as="geometry"/></mxCell></object><object id="managers-n409" label="Membership agreements &amp; annual fees&lt;br&gt;Track signatures, payment follow-up"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1102" y="1057" width="426" height="78" as="geometry"/></mxCell></object><object id="managers-n416" label="COMMON MANAGEMENT CYCLE • eight original branches retained"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;fontStyle=1;fontSize=19;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="40" y="1280" width="1520" height="40" as="geometry"/></mxCell></object><object id="managers-n417" l