 member reference&lt;br&gt;Assign internal coordination task [05]"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1102" y="277" width="426" height="78" as="geometry"/></mxCell></object><object id="membership-n458" label="Rejected / unanswered?&lt;br&gt;Capture reason; owner coordinates next step"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1102" y="407" width="426" height="78" as="geometry"/></mxCell></object><object id="membership-n459" label="Track member and client follow-ups&lt;br&gt;Record call outcomes and external waiting"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1102" y="537" width="426" height="78" as="geometry"/></mxCell></object><object id="membership-n460" label="Lead Manager follows concluded deals&lt;br&gt;GM coordinates accounts and exceptions"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1102" y="667" width="426" height="78" as="geometry"/></mxCell></object><object id="membership-n461" label="Terms disputed / evidence missing?&lt;br&gt;Return to business authority for correction"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1102" y="797" width="426" height="78" as="geometry"/></mxCell></object><object id="membership-n462" label="Unpaid? Set follow-up date and owner&lt;br&gt;Ageing balance remains open / escalate"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1102" y="927" width="426" height="78" as="geometry"/></mxCell></object><object id="membership-n463" label="Verify payment confirmation source&lt;br&gt;No completion from a promised payment"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1102" y="1057" width="426" height="78" as="geometry"/></mxCell></object><object id="membership-n464" label="Close approved coordination task&lt;br&gt;Keep CRM and task outcomes distinct"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FFF1E4;strokeColor=#C66B17;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1102" y="1187" width="426" height="78" as="geometry"/></mxCell></object><object id="membership-n474" label="ROYALTY CONTEXT • validated against company PDF and CRM calculation code"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;fontStyle=1;fontSize=19;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="40" y="1420" width="1520" height="40" as="geometry"/></mxCell></object><object id="membership-n475" label="Lease brokerage&lt;br&gt;ROUND(monthly rate × area × agreed lease days ÷ 30)&lt;br&gt;&lt;br&gt;Sale brokerage&lt;br&gt;ROUND(1% × outright rate × area)"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F0EBFA;strokeColor=#70529D;fontCol