ze=12;fillColor=#E8F5EF;strokeColor=#2D7B5C;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1102" y="537" width="426" height="78" as="geometry"/></mxCell></object><object id="execution-n519" label="Conference presentation collaterals&lt;br&gt;Coordinate slides and digital archives"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#E8F5EF;strokeColor=#2D7B5C;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1102" y="667" width="426" height="78" as="geometry"/></mxCell></object><object id="execution-n520" label="Design IDs, banners and nameplates&lt;br&gt;Stationery and other event materials"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#E8F5EF;strokeColor=#2D7B5C;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1102" y="797" width="426" height="78" as="geometry"/></mxCell></object><object id="execution-n521" label="Manager approves final versions&lt;br&gt;Lead Manager coordinates printers"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#E8F5EF;strokeColor=#2D7B5C;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1102" y="927" width="426" height="78" as="geometry"/></mxCell></object><object id="execution-n522" label="Record received / delivered outputs&lt;br&gt;Resolve quality issues before closure"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#E8F5EF;strokeColor=#2D7B5C;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1102" y="1057" width="426" height="78" as="geometry"/></mxCell></object><object id="execution-n523" label="Submit task evidence for review [05]&lt;br&gt;Request help or report blockers [06]"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#E8F5EF;strokeColor=#2D7B5C;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1102" y="1187" width="426" height="78" as="geometry"/></mxCell></object><object id="execution-n531" label="Creative release gate&lt;br&gt;Brief → Drafting → Internal Review → Changes Requested → Approved → Published. Changes loop back to drafting and review. A design approval alone does not mean the item has been published."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="70" y="1450" width="710" height="130" as="geometry"/></mxCell></object><object id="execution-n532" label="Work attribution&lt;br&gt;Harshitha can switch between Creatives Associate and Executive. Separate employee accounts remain for separate people, including social media and graphic design staff."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="825" y="1450" width="710" height="130" as="geometry"/></mxCell></object></root></mxGraphModel></diagram><diagram id="analytics" name="12 • Operational records → intelligence → action"><mxGraphModel dx="1600" dy="1640" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1640" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="analytics-e538" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#6B7B8D;strokeWidth=1.4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="analytics-n536" target="analytics-n537"><mxGeometry relative="1" as="geom