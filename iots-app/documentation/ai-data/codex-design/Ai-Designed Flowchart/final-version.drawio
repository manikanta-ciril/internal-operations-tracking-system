l=1;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#6B7B8D;strokeWidth=1.4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="analytics-n562" target="analytics-n566"><mxGeometry relative="1" as="geometry"/></mxCell><object id="analytics-n533" label="12 • Operational records → intelligence → action"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;fontStyle=1;fontSize=19;fillColor=#19344A;strokeColor=#19344A;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1520" height="55" as="geometry"/></mxCell></object><object id="analytics-n534" label="LAYER 3 • Analysis reads recorded work and preserves permission scope. Every indicator links to the records that explain it."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=0;strokeOpacity=0;align=left;fillColor=#F5F7FA;strokeColor=#6B7B8D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1520" height="45" as="geometry"/></mxCell></object><object id="analytics-n535" label="← OVERVIEW" link="data:page/id,overview"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1350" y="145" width="210" height="36" as="geometry"/></mxCell></object><object id="analytics-n536" label="Source records&lt;br&gt;Tasks &amp; state history • activity &amp; evidence • attendance &amp; availability • requests &amp; decisions • issues &amp; escalations • audit • targets • verified CRM references"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;shape=cylinder3;size=12;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="120" y="200" width="1360" height="100" as="geometry"/></mxCell></object><object id="analytics-n537" label="Choose period and authorised scope&lt;br&gt;Aggregate once per task; preserve assignment and deadline history; apply versioned targets and rules"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="320" y="355" width="960" height="80" as="geometry"/></mxCell></object><object id="analytics-n539" label="PERFORMANCE&lt;br&gt;Completion and on-time delivery&lt;br&gt;Elapsed completion vs active effort&lt;br&gt;Targets; quality and revision rate"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="50" y="500" width="365" height="130" as="geometry"/></mxCell></object><object id="analytics-n540" label="WORKLOAD&lt;br&gt;Pending, overdue and blocked work&lt;br&gt;Capacity, priority and deadline pressure&lt;br&gt;Reassignment event frequency"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="435" y="500" width="365" height="130" as="geometry"/></mxCell></object><object id="analytics-n541" label="ATTENDANCE&lt;br&gt;Lateness, absence and hours&lt;br&gt;Availability and remote / unknown trends&lt;br&gt;Approved leave and corrections visible"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="820" y="500" width="365" height="130" as="geometry"/></mxCell></object><object id="analytics-n542" label="TRENDS &amp; RISKS&lt;br&gt;Day / week / month comparisons&lt;br&gt;Low / medium / high configured rules&lt;br&gt;Reasons and linked evidence for each flag"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1205" y="500" width="365" height="130" as="geometry"/></mxCell></object><object id="analytics-n547" label="Generate scoped reports&lt;br&gt;On schedule or authorised request"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="580" y="705" width="440" height="80" as="geometry"/></mxCell></object><object id="analytics-n552" label="DAILY&lt;br&gt;Today’s outcomes, open blockers, overdue work and next priorities"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="80" y="835" width="440" height="100" as="geometry"/></mxCell></object><object id="analytics-n553" label="WEEKLY&lt;br&gt;Team delivery, workload balance, recurring delays and targets"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="580" y="835" width="440" height="100" as="geometry"/></mxCell></object><object id="analytics-n554" label="MONTHLY&lt;br&gt;Trends, appraisal inputs, royalty status and recognition standings"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="1080" y="835" width="440" height="100" as="geometry"/></mxCell></object><object id="analytics-n558" label="Apply recipient scope&lt;br&gt;Employee: own records • Lead Manager: team • Senior / GM: authorised teams&lt;br&gt;Chairman: enterprise reports • Admin / SA / IT: permitted administration and audit"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="250" y="1010" width="1100" height="100" as="geometry"/></mxCell></object><object id="analytics-n562" label="Deliver dashboard / PDF / Excel / authorised email&lt;br&gt;Chairman appraisal-format export uses configured template; log exports"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="320" y="1170" width="960" height="85" as="geometry"/></mxCell></object><object id="analytics-n564" label="Attention item → authorised intervention [06]&lt;br&gt;Detected → Reviewed → Action taken → Resolved" link="data:page/id,exceptions"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#FBEDED;strokeColor=#B35C65;fontColor=#1B2935;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="70" y="1320" width="710" height="60" as="geometry"/></mxCell></object><object id="analytics-n566" label="Drill down within scope&lt;br&gt;Team → Employee → Task / Request / Attendance&lt;br&gt;Activity → Evidence → Decision and audit history"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="830" y="1320" width="700" height="85" as="geometry"/></mxCell></object><object id="analytics-n568" label="Metric rules: show counts and denominators; cancelled tasks are excluded from completion where administrative; reassignment never creates another task count; zero denominators show N/A; missing targets show “Target not configured”."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=0;strokeOpacity=0;align=left;fillColor=#F5F7FA;strokeColor=#6B7B8D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="40" y="1450" width="1520" height="65" as="geometry"/></mxCell></object><object id="analytics-n569" label="On-time results use the applicable approved deadline and retain original-deadline / extension history. Prior overdue events stay visible. Workload warnings are configurable rules; approval and reassignment remain human decisions. Predictive models are a future option."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=0;strokeOpacity=0;align=left;fillColor=#F5F7FA;strokeColor=#6B7B8D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="40" y="1520" width="1520" height="65" as="geometry"/></mxCell></object></root></mxGraphModel></diagram><diagram id="chairman" name="13 • Chairman oversight, appraisal &amp; recognition"><mxGraphModel dx="1600" dy="1540" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1540" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="chairman-e580" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#70529D;strokeWidth=1.4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="chairman-n574" target="chairman-n575"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="chairman-e581" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Arial;fontSize=12;labelBa