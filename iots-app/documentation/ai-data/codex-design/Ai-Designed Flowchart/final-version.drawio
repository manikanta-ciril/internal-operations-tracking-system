90" y="1200" width="690" height="100" as="geometry"/></mxCell></object><object id="admin-n202" label="Escalation boundaries&lt;br&gt;Admin sends technical faults to IT [08]; operational decisions to the designated manager [09]. Platform access alone never grants commercial or leave approval."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=1;arcSize=12;fillColor=#F0EBFA;strokeColor=#70529D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="835" y="1200" width="680" height="100" as="geometry"/></mxCell></object><object id="admin-n203" label="SA = Super Admin. Role changes, account deactivation and delegated interventions preserve existing work history and notify the responsible owner."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=1.3;shadow=0;rounded=0;strokeOpacity=0;align=left;fillColor=#F5F7FA;strokeColor=#6B7B8D;fontColor=#1B2935;" vertex="1" parent="1"><mxGeometry x="40" y="1340" width="1520" height="50" as="geometry"/></mxCell></object></root></mxGraphModel></diagram><diagram id="tasks" name="05 • Shared work lifecycle: plan → deliver → review → close"><mxGraphModel dx="1600" dy="1630" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1630" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="tasks-e214" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#C66B17;strokeWidth=1.4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="tasks-n210" target="tasks-n211"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tasks-e215" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#C66B17;stroke